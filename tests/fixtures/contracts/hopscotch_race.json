{
  "fg_env": "2",
  "name": "Hopscotch race",
  "description": "Two friends race along a hopscotch court. A turn is up to two hops that land together; a turn ending on a stone is undone and played again. Turns are timed, and a spectator view follows the race.",
  "brief": {
    "situation": "Two friends race along a hopscotch court of {$world.length} squares. Some squares hold a stone.",
    "rules": "Each turn, hop up to twice (1 to 3 squares a hop). Your turn must end on a square without a stone, or every hop of it is undone and you play it again. Take too long and you slide back a square. The first to the last square wins."
  },
  "clock": {"rounds": 12, "unit": "turn"},
  "world": {"length": 20, "stones": {"type": "list", "default": [4, 7, 11, 15, 18]}},
  "types": {"player": {"agent": true, "props": {"square": 0}}},
  "entities": {"ana": {"type": "player", "name": "Ana"}, "ben": {"type": "player", "name": "Ben"}},
  "actions": {
    "hop": {
      "by": "player",
      "description": "Hop forward 1 to 3 squares.",
      "params": {"squares": {"type": "int", "min": 1, "max": 3}},
      "do": ["$actor.square = $min($actor.square + $params.squares, $world.length)"],
      "outcome": "You hop to square {$actor.square}."
    }
  },
  "stages": [
    {
      "name": "hop",
      "max_actions": 2,
      "valid": [{"expr": "$actor.square not in $world.stones", "why": "square {$actor.square} holds a stone"}]
    }
  ],
  "views": {
    "court": {"for": "player", "title": "Court", "of": "player", "sort": "$it.square", "desc": true, "show": "{name}: square {square}"},
    "stones": {"for": "player", "show": "Stones lie on squares {$world.stones}."},
    "race": {"for": "spectator", "title": "Race", "of": "player", "sort": "$it.square", "desc": true, "bullet": false, "show": "{name}: square {square} of {$world.length}, {$world.length - $it.square} to go"}
  },
  "events": [{"on": "stage.hop.turn", "when": "$timed_out", "do": ["$actor.square = $max($actor.square - 1, 0)"]}],
  "outputs": {
    "winner": {"expr": "$top(player, $it.square, 1)[0].name", "type": "text"},
    "leader_square": {"expr": "$max(player, $it.square)", "type": "int", "series": true}
  },
  "end": [
    {"when": "$count(player, $it.square >= $world.length) > 0", "name": "finished", "winner": "$top(player, $it.square, 1)[0].name", "say": "{$top(player, $it.square, 1)[0].name} reaches the last square."}
  ]
}

{
  "fg_env": "1",
  "name": "Contact centre peak",
  "description": "Four peak hours (09:00-13:00) of the business study's contact centre at a quarter of its volume, one half hour a round, with its fitted handle times and calibrated patience. Calls arrive at each half hour's forecast rate, wait in one queue, are answered by the agents logged in that half hour or hang up when their patience runs out.",
  "inputs": {
    "estimates": {
      "type": "map",
      "source": "estimates.json",
      "description": "Handle time per half hour, shrinkage, cost per agent hour."
    },
    "forecast": {
      "type": "table",
      "source": "forecast.csv",
      "columns": {
        "slot": "int",
        "calls_expected": "number"
      }
    },
    "agents": {
      "type": "list",
      "default": [],
      "description": "Agents logged in per half hour; empty = the manager's rule."
    },
    "aht_sd_log": {
      "type": "number",
      "default": 0.375,
      "min": 0.1,
      "max": 1.2
    },
    "patience_sec": {
      "type": "number",
      "default": 400,
      "min": 20,
      "max": 900
    },
    "sl_seconds": {
      "type": "number",
      "default": 30
    },
    "sl_target": {
      "type": "number",
      "default": 0.8
    }
  },
  "clock": {
    "rounds": "$len($inputs.forecast)",
    "unit": "minute",
    "step": 30
  },
  "world": {
    "plan": {
      "type": "list",
      "default": "$inputs.agents"
    }
  },
  "types": {},
  "events": [
    {
      "name": "rule",
      "when": "$round == 1 and $len($world.plan) != $len($inputs.forecast)",
      "do": [
        "$world.plan = $map($range($len($inputs.forecast)), $max(2, $ceil($inputs.forecast[$it].calls_expected * $inputs.estimates.aht_by_slot[$it] / 1800 * 1.1 + 2)))"
      ]
    }
  ],
  "mechanisms": {
    "centre": {
      "kind": "operations",
      "mode": "queue",
      "unit": "second",
      "interval": 1800,
      "channels": {
        "calls": {
          "arrivals": "$inputs.forecast[$interval].calls_expected",
          "service": {
            "dist": "lognormal",
            "mean": "$inputs.estimates.aht_by_slot[$interval]",
            "cv": "$sqrt($exp($inputs.aht_sd_log ** 2) - 1)"
          },
          "patience": {
            "mean": "$inputs.patience_sec"
          },
          "threshold": 30,
          "target": 0.8
        }
      },
      "servers": {
        "agents": {
          "staff": "$world.plan[$interval]"
        }
      }
    }
  },
  "outputs": {
    "sl": {
      "type": "number",
      "expr": "$round($world.centre_totals.service_level, 4)",
      "description": "Share of calls answered within the threshold."
    },
    "staffing_cost": {
      "type": "number",
      "expr": "$round($sum($world.plan) / 2 / (1 - $inputs.estimates.shrinkage) * $inputs.estimates.agent_cost_per_hour, 0)"
    },
    "plan": {
      "type": "list",
      "expr": "$world.plan"
    }
  }
}

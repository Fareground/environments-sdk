       "villager"
      ]
     },
     "know": [
      "wolves"
     ],
     "reveal": "never",
     "alive": "living"
    }
   },
   "records": {
    "talk": {
     "fields": {
      "text": "text"
     },
     "show": "{author}: {text}"
    },
    "wolf_chat": {
     "fields": {
      "text": "text"
     },
     "show": "{author}: {text}",
     "visible": "$viewer.role == werewolf"
    }
   },
   "actions": {
    "choose_kill": {
     "by": "player",
     "description": "Nominate the living player the werewolves should kill tonight. All living werewolves must nominate the same player for the kill to succeed.",
     "when": [
      "$actor.living",
      "$actor.role == werewolf"
     ],
     "params": {
      "target": {
       "type": "entity",
       "of": "player",
       "where": "$it.living and $it.id != $actor.id"
      }
     },
     "do": [
      "$world.kill_votes[$actor.id] = $params.target.id"
     ],
     "private": true,
     "outcome": "You nominated {$params.target.name} for tonight's kill.",
     "per_turn": 1
    },
    "inspect_role": {
     "by": "player",
     "description": "Privately learn the true role of one living player.",
     "when": [
      "$actor.living",
      "$actor.role == seer"
     ],
     "params": {
      "target": {
       "type": "entity",
       "of": "player",
       "where": "$it.living and $it.id != $actor.id"
      }
     },
     "do": [],
     "private": true,
     "outcome": "{$params.target.name} is {$params.target.role}.",
     "per_turn": 1
    },
    "speak": {
     "by": "player",
     "description": "Say something to the surviving village. You may lie freely.",
     "when": [
      "$actor.living"
     ],
     "params": {
      "text": {
       "type": "text",
       "max_len": 300
      }
     },
     "do": [
      {
       "post": "talk",
       "text": "$params.text"
      }
     ],
     "outcome": "You spoke to the village.",
     "per_turn": 2
    },
    "day_vote": {
     "by": "player",
     "description": "Cast your sealed vote to eliminate one living player today.",
     "when": [
      "$actor.living"
     ],
     "params": {
      "target": {
       "type": "entity",
       "of": "player",
       "where": "$it.living"
      }
     },
     "do": [
      "$world.day_ballots[$actor.id] = $params.target.id"
     ],
     "private": true,
     "outcome": "You voted to eliminate {$params.target.name}.",
     "per_turn": 1
    },
    "wolves_speak": {
     "by": "player",
     "description": "Speak privately to the other werewolf.",
     "when": [
      "$actor.living",
      "$actor.role == werewolf"
     ],
     "params": {
      "text": {
       "type": "text",
       "max_len": 200
      }
     },
     "do": [
      {
       "post": "wolf_chat",
       "text": "$params.text"
      }
     ],
     "outcome": "You spoke to your pack.",
     "per_turn": 2
    }
   },
   "stages": [
    {
     "name": "night_wolves",
     "when": "$count(player, $it.living and $it.role == werewolf) > 0",
     "who": "$it.living and $it.role == werewolf",
     "actions": [
      "wolves_speak",
      "choose_kill"
     ],
     "max_actions": 3,
     "on_enter": [
      "$world.kill_votes = {}"
     ],
     "on_exit": [
      {
       "if": "$world.kill_votes == {}",
       "then": [],
       "else": [
        "$t = $tally($values($world.kill_votes))",
        "$mx = $max($values($t))",
        "$top = $filter($keys($t), $get($t, $it, 0) == $mx)",
        {
         "if": "$len($top) == 1",
         "then": [
          {
           "each": "player",
           "where": "$it.id == $top[0]",
           "do": [
            "$it.living = false"
           ]
          },
          "$world.dead_order += $top[0]",
          {
           "emit": "news",
           "say": "The werewolves killed {$entity($top[0]).name} in the night."
          }
         ],
         "else": [
          {
           "emit": "news",
           "say": "The werewolves could not agree; nobody died in the night."
          }
         ]
        }
       ]
      }
     ]
    },
    {
     "name": "night_seer",
     "when": "$count(player, $it.living and $it.role == seer) == 1",
     "who": "$it.living and $it.role == seer",
     "actions": [
      "inspect_role"
     ],
     "max_actions": 1
    },
    {
     "name": "day_discussion",
     "who": "$it.living",
     "actions": [
      "speak"
     ],
     "max_actions": 2
    },
    {
     "name": "day_vote",
     "who": "$it.living",
     "actions": [
      "day_vote"
     ],
     "turns": "simultaneous",
     "max_actions": 1,
     "on_enter": [
      "$world.day_ballots = {}"
     ],
     "on_exit": [
      "$opts = $map($filter(player, $it.living), $it.id)",
      "$res = $tally_votes('plurality', $world.day_ballots, $opts, null, 'none')",
      {
       "if": "$res.winner == null",
       "then": [
        {
         "emit": "news",
         "say": "The village vote was tied; nobody was eliminated."
        }
       ],
       "else": [
        {
         "each": "player",
         "where": "$it.id == $res.winner",
         "do": [
          "$it.living = false"
         ]
        },
        "$world.dead_order += $res.winner",
        {
         "emit": "news",
         "say": "By vote, {$entity($res.winner).name} was eliminated."
        }
       ]
      }
     ]
    }
   ],
   "end": [
    {
     "name": "village_wins",
     "when": "$count(player, $it.living and $it.role == werewolf) == 0",
     "winner": "village",
     "say": "Both werewolves are gone. The village wins!"
    },
    {
     "name": "werewolves_win",
     "when": "$count(player, $it.living and $it.role == werewolf) > 0 and $count(player, $it.living and $it.role == werewolf) >= $count(player, $it.living and $it.role != werewolf)",
     "winner": "werewolves",
     "say": "The werewolves equal or outnumber the rest. The werewolves win!"
    }
   ],
   "views": {
    "village": {
     "of": "player",
     "where": "$it.living",
     "show": "[{id}] {name}"
    },
    "graveyard": {
     "of": "player",
     "where": "not $it.living",
     "show": "[{id}] {name} \u2014 died",
     "empty": "No one has died yet."
    },
    "day": {
     "show": "Day {$round}. Alive: {$count(player, $it.living)}."
    }
   },
   "metrics": {
    "wolves_alive": "$count(player, $it.living and $it.role == werewolf)",
    "village_alive": "$count(player, $it.living and $it.role != werewolf)"
   },
   "outputs": {
    "winner": {
     "expr": "$result.winner",
     "type": "any"
    },
    "roles": {
     "expr": "$dict(player, $it.id, $it.role)",
     "type": "map"
    },
    "eliminated": {
     "expr": "$world.dead_order",
     "type": "list"
    },
    "alive_end": {
     "expr": "$map($filter(player, $it.living), $it.id)",
     "type": "list"
    }
   },
   "invariants": [
    {
     "expr": "$count(player, not $it.living) == $len($world.dead_order)",
     "why": "Every dead player is recorded once.",
     "check": "round"
    }
   ]
  }

  {
   "name": "Werewolf",
   "brief": {
    "situation": "A village of seven: two secret werewolves hide among you. Each night the werewolves kill one living player; the seer privately learns one living player's role. Each day the survivors discuss, then vote to eliminate one of you. Roles are never revealed in death.",
    "rules": "Night: if all living werewolves nominate the same living player, that player dies. Seer: privately inspect one living player's role each night. Day: each living player may speak, then vote for one living player; the player with the most votes is eliminated, but a tie eliminates nobody. Village wins when both werewolves are gone. Werewolves win when they are at least as many as everyone else alive. After {$inputs.days} days with no winner, nobody wins.",
    "roles": {
     "player": "You are {$actor.role} (team {$actor.team})."
    }
   },
   "clock": {
    "rounds": "$inputs.days",
    "unit": "day"
   },
   "inputs": {
    "days": {
     "type": "int",
     "default": 10,
     "min": 1,
     "display": "number",
     "label": "Days before the game ends"
    }
   },
   "world": {
    "kill_votes": {},
    "day_ballots": {},
    "dead_order": []
   },
   "types": {
    "player": {
     "agent": true,
     "props": {
      "living": true
     }
    }
   },
   "entities": {
    "p1": {
     "type": "player",
     "name": "Alex"
    },
    "p2": {
     "type": "player",
     "name": "Blair"
    },
    "p3": {
     "type": "player",
     "name": "Casey"
    },
    "p4": {
     "type": "player",
     "name": "Dana"
    },
    "p5": {
     "type": "player",
     "name": "Emery"
    },
    "p6": {
     "type": "player",
     "name": "Finley"
    },
    "p7": {
     "type": "player",
     "name": "Gray"
    }
   },
   "mechanisms": {
    "roles": {
     "kind": "groups",
     "mode": "roles",
     "who": "player",
     "deck": {
      "werewolf": 2,
      "seer": 1,
      "villager": "rest"
     },
     "teams": {
      "wolves": [
       "werewolf"
      ],
      "village": [

{
  "fg_env": "2",
  "name": "Network Engine",
  "description": "A reusable human network engine for explicit relationships, trust-weighted exposure, influence, and behavioral adoption without geography or physical propagation. Word of mouth spreads the idea on its own each round; people may also adopt what they heard, turn it down, or recommend it to a contact (adopters, the seed included, stay committed), and the coded baseline leaves it to word of mouth.",
  "brief": {
    "situation": "An idea or behavior moves through an explicit human relationship network.",
    "rules": "Each interaction, everyone who has adopted the idea may convince each person they are tied to: the chance is the tie's trust times that person's receptivity, so trusted ties and more time spread it further. On your turn you may also take up an idea you have heard about, turn it down (you will not take it up or pass it on), or, once you hold it, recommend it to one contact; adopters stay committed. This engine models human influence and information flow, not physical movement.",
    "roles": {"person": "React to information through your relationships according to your persona, trust, and receptivity."}
  },
  "inputs": {
    "rounds": {"type": "int", "default": 5, "min": 1, "max": 50},
    "seeds": {
      "type": "list",
      "items": {"type": "text", "required": true},
      "default": ["p1"],
      "description": "Ids of the people who hold the idea at the start (each must be in participants; [] for nobody)."
    },
    "participants": {
      "type": "table",
      "description": "People supplied directly or by the shared persona sampler.",
      "columns": {"id": "text", "name": "text", "group": "text", "receptivity": "number"},

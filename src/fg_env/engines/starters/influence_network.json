  "clock": {"rounds": "$inputs.rounds", "unit": "interaction"},
  "types": {
    "person": {
      "agent": true,
      "policy": "word_of_mouth",
      "props": {
        "group": {"type": "text", "default": ""},
        "receptivity": {"type": "number", "default": 0.5, "min": 0, "max": 1, "private": true},
        "adoptions": {"type": "int", "default": 0}
      },
      "policies": {"word_of_mouth": {"rules": [{"do": "pass"}]}}
    }
  },
  "entities": {
    "person": {
      "type": "person",
      "from": "$inputs.participants",
      "id": "{$row.id}",
      "name": "{$row.name}",
      "props": {"group": "$row.group", "receptivity": "$row.receptivity"}
    }
  },
  "relations": {"knows": {"symmetric": true, "links": [{"rows": "$filter($inputs.ties, $it.from in $map($inputs.participants, $it.id) and $it.to in $map($inputs.participants, $it.id))"}]}},
  "actions": {
    "adopt": {
      "by": "person",
      "description": "Take up the idea you have heard about.",
      "terminal": true,
      "when": [
        {"expr": "$spread_state($actor, proposal) == exposed", "why": "You have not heard about it yet, or have already decided."}
      ],
      "do": [{"social": "influence", "action": "adopt", "item": "proposal", "who": "$actor"}]
    },
    "reject": {
      "by": "person",
      "description": "Turn down the idea you have heard about: you will not take it up or pass it on.",
      "terminal": true,
      "when": [
        {"expr": "$spread_state($actor, proposal) == exposed", "why": "You have not heard about it yet, or have already decided (adopters stay committed)."}
      ],
      "do": [{"social": "influence", "action": "reject", "item": "proposal", "who": "$actor"}]
    },
    "share": {
      "by": "person",
      "per_turn": 1,
      "description": "Recommend the idea to one of your contacts: they take it up with a chance of your tie's trust times their receptivity, and otherwise have at least heard of it.",
      "when": [
        {"expr": "$spread_state($actor, proposal) == adopted", "why": "Only people who hold the idea can recommend it."}
      ],
      "params": {
        "contact": {"type": "entity", "of": "person", "where": "$linked($actor, $it, knows) and $spread_state($it, proposal) in [unaware, exposed]"}
      },
      "do": [
        {
          "if": "$chance($relation($actor, $params.contact, knows) * $params.contact.receptivity)",
          "then": [{"social": "influence", "action": "adopt", "item": "proposal", "who": "$params.contact"}],
          "else": [{"social": "influence", "action": "expose", "item": "proposal", "who": "$params.contact"}]
        }
      ]
    }
  },
  "views": {
    "exposure": {"for": "person", "title": "Your exposure", "of": "$heard($actor)", "show": "{item}: {state}; {exposures} exposure(s)"}
  },
  "events": [
    {
      "name": "seeding",
      "on": "round.start",
      "when": "$round == 1",
      "do": [
        {
          "each": "person",
          "where": "$it.id in $inputs.seeds",
          "do": [{"social": "influence", "action": "adopt", "item": "proposal", "who": "$it"}]
        }
      ]
    }
  ],
  "outputs": {
    "population_size": {"type": "int", "expr": "$count(person)"},
    "reached": {"type": "int", "expr": "$reach(proposal)"},
    "adopted": {"type": "int", "expr": "$adopter_count(proposal)"},
    "adoption_rate": {"type": "number", "expr": "$adopter_count(proposal) / $count(person) if $count(person) > 0 else null", "series": true},
    "reach": {"expr": "$reach(proposal)", "series": true}
  },
  "invariants": [
    {"expr": "$all($inputs.seeds, $it in $map(person, $it.id))", "why": "inputs.seeds names someone who is not in inputs.participants: give the ids of people in the table, or [] for no initial adopter."},
    {"expr": "$all($inputs.ties, $it.from in $map(person, $it.id) and $it.to in $map(person, $it.id))", "why": "inputs.ties names someone who is not in inputs.participants: give ties only between people in the table (a smaller participants table needs its own ties)."}
  ],
  "mechanisms": {
    "influence": {
      "kind": "social",
      "mode": "diffusion",
      "who": "person",
      "over": "knows",
      "flow": "both",
      "model": "cascade",
      "persistent": true,
      "p": "$relation($from, $to, knows) * $to.receptivity",
      "seeds": {"proposal": []},
      "on_adopt": ["$it.adoptions += 1"]
    }
  }
}

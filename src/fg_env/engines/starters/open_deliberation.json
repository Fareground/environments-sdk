{
  "fg_env": "1",
  "name": "Deliberation Engine",
  "description": "A reusable deliberation engine in which people exchange reasons, revise views, propose a conclusion, and vote. Each speech pulls every listener's stance part of the way toward the speaker's, so views move during the debate and the vote can go either way.",
  "inputs": {
    "question": {"type": "text", "default": "Should the group adopt the proposed course of action?"},
    "persuasion": {"type": "number", "default": 0.3, "min": 0, "max": 0.5, "description": "Average share of the gap to a speaker's stance that each listener moves per speech (each listener draws between 0 and twice this); 0 = nobody changes their mind."},
    "participants": {
      "type": "table",
      "columns": {"id": "text", "name": "text", "stance": "number", "perspective": "text"},
      "default": [
        {"id": "m1", "name": "Member 1", "stance": 0.7, "perspective": "Focuses on expected benefits."},
        {"id": "m2", "name": "Member 2", "stance": -0.6, "perspective": "Focuses on risks and safeguards."},
        {"id": "m3", "name": "Member 3", "stance": 0.2, "perspective": "Looks for a workable compromise."}
      ]
    }
  },
  "brief": {
    "situation": "A group is considering: {$inputs.question}",
    "rules": "Members may speak, propose a conclusion, second it, amend it, signal readiness, call the question, and vote. Every speech moves each listener's stance part of the way toward the speaker's. The purpose is reasoned view revision rather than role-specific institutional procedure.",
    "roles": {"member": "Contribute your perspective, listen to reasons, revise when warranted, and vote according to your considered judgment."}
  },
  "clock": {"rounds": 3, "unit": "session"},
  "types": {"member": {"agent": true, "policy": "baseline", "props": {
    "stance": {"type": "number", "default": 0, "min": -1, "max": 1, "private": true, "description": "Current view, from -1 (against) to 1 (for); speeches move it."},
    "perspective": {"type": "text", "default": "", "private": true}
  }}},
  "population": [{"type": "member", "from": "$inputs.participants", "id": "{$row.id}", "name": "{$row.name}", "props": {"stance": "$row.stance", "perspective": "$row.perspective"}}],
  "mechanisms": {"forum": {
    "kind": "decision", "mode": "deliberation", "who": "member", "question": "$inputs.question",
    "passes": 4, "method": "majority", "floor": false, "motions": true,
    "second": true, "amendments": true, "min_debate": 1, "private": true, "backstop": "vote", "end": "decision"
  }},
  "views": {"private_view": {"for": "member", "show": "Your current stance is {stance|2}. Your perspective: {perspective}"}},
  "world": {"heard": {"type": "int", "default": 0, "description": "Speeches whose persuasion has been applied."}},
  "defs": {
    "open_motion": "$pending_motion() != null and $pending_motion().status == 'open'",
    "speeches": "$filter($records(forum), $it.says == says)",
    "debate": {"args": ["motion"], "expr": "$filter($speeches, $it.motion == $motion.id)", "description": "Speeches on this motion."}
  },
  "triggers": [{"name": "persuasion", "when": "$len($speeches) > $world.heard", "do": [
    "$speaker = $last($speeches).author", "$world.heard = $len($speeches)",
    {"each": "member", "where": "$it.id != $speaker.id", "do": ["$it.stance += $uniform(0, 2 * $inputs.persuasion) * ($speaker.stance - $it.stance)"]}
  ]}],
  "policies": {"baseline": {"repeat": true, "rules": [
    {"when": "$world.forum.phase == voting", "do": "forum_vote", "with": {"choice": "$'yes' if $actor.stance >= 0 else 'no'"}},
    {"when": "$pending_motion() == null and $abs($actor.stance) > 0.4", "do": "forum_propose", "with": {"text": "$inputs.question"}},
    {"when": "$pending_motion() != null and $pending_motion().status == proposed and $pending_motion().mover != $actor.id", "do": "forum_second"},
    {"when": "$open_motion and not $any($debate($pending_motion()), $it.author.id == $actor.id)", "do": "forum_speak", "with": {"text": "$actor.perspective"}},
    {"when": "$open_motion and $len($debate($pending_motion())) >= $count(member)", "do": "forum_call_question"},
    {"do": "forum_ready"}
  ]}},
  "metrics": {"contributions": {"expr": "$len($speeches)"}},
  "outputs": {
    "decided": {"type": "bool", "expr": "$len($decisions()) > 0"},
    "outcome": {"type": "text", "expr": "('passed' if $last($decisions()).passed else 'rejected') if $len($decisions()) > 0 else 'status_quo'", "description": "passed, rejected, or status_quo when nothing came to a vote."},
    "passed": {"type": "bool", "expr": "$last($decisions()).passed if $len($decisions()) > 0 else null"},
    "conclusion": {"type": "text", "expr": "$last($decisions()).text if $len($decisions()) > 0 else null"},
    "yes": {"type": "int", "expr": "$last($decisions()).counts.yes if $len($decisions()) > 0 else 0"},
    "no": {"type": "int", "expr": "$last($decisions()).counts.no if $len($decisions()) > 0 else 0"},
    "contributions": {"type": "int", "expr": "$metrics.contributions"}
  }
}

{
  "fg_env": "1",
  "name": "Legislature Engine",
  "description": "A reusable configurable legislative body with sponsorship, recognition, debate, seconds, amendments, procedural voting, party positions, and recorded outcomes. Each member's view blends where they started with the average stance of the floor speeches so far, a speech from their own party counting more than one from another, so debate can change the vote without talking the chamber into unanimity. A speech's stance is what a bound judge host ('judge') reads in its words (direction times strength); without one, coded members react to the speaker's own stance, not to what is said.",
  "inputs": {
    "body_name": {"type": "text", "default": "Legislative body"},
    "bill": {"type": "text", "default": "Adopt the proposed measure."},
    "persuasion": {"type": "number", "default": 0.3, "min": 0, "max": 0.5, "description": "Average share of a member's view that comes from the floor speeches rather than their starting stance (each member draws between 0 and twice this); 0 = debate changes no votes."},
    "party_loyalty": {"type": "number", "default": 0.5, "min": 0, "max": 1, "description": "How much less a member weighs a speaker of another party than one of their own: 0 = party makes no difference, 1 = only their own party persuades them."},
    "members": {
      "type": "table",
      "columns": {"id": "text", "name": "text", "party": "text", "stance": "number", "sponsor": "bool"},
      "default": [
        {"id": "l1", "name": "Member 1", "party": "A", "stance": 0.71, "sponsor": true},
        {"id": "l2", "name": "Member 2", "party": "A", "stance": 0.47, "sponsor": false},
        {"id": "l3", "name": "Member 3", "party": "A", "stance": 0.37, "sponsor": false},
        {"id": "l4", "name": "Member 4", "party": "A", "stance": 0.35, "sponsor": false},
        {"id": "l5", "name": "Member 5", "party": "A", "stance": 0.21, "sponsor": false},
        {"id": "l6", "name": "Member 6", "party": "A", "stance": -0.01, "sponsor": false},
        {"id": "l7", "name": "Member 7", "party": "A", "stance": 0.06, "sponsor": false},
        {"id": "l8", "name": "Member 8", "party": "A", "stance": 0.1, "sponsor": false},
        {"id": "l9", "name": "Member 9", "party": "A", "stance": 0.3, "sponsor": false},
        {"id": "l10", "name": "Member 10", "party": "A", "stance": 0.54, "sponsor": false},
        {"id": "l11", "name": "Member 11", "party": "A", "stance": -0.09, "sponsor": false},
        {"id": "l12", "name": "Member 12", "party": "B", "stance": -0.75, "sponsor": false},
        {"id": "l13", "name": "Member 13", "party": "B", "stance": -0.34, "sponsor": false},
        {"id": "l14", "name": "Member 14", "party": "B", "stance": -0.22, "sponsor": false},
        {"id": "l15", "name": "Member 15", "party": "B", "stance": -0.03, "sponsor": false},
        {"id": "l16", "name": "Member 16", "party": "B", "stance": -0.39, "sponsor": false},
        {"id": "l17", "name": "Member 17", "party": "B", "stance": -0.58, "sponsor": false},
        {"id": "l18", "name": "Member 18", "party": "B", "stance": -0.16, "sponsor": false},
        {"id": "l19", "name": "Member 19", "party": "B", "stance": -0.11, "sponsor": false},
        {"id": "l20", "name": "Member 20", "party": "B", "stance": -0.18, "sponsor": false},
        {"id": "l21", "name": "Member 21", "party": "B", "stance": -0.16, "sponsor": false},
        {"id": "l22", "name": "Member 22", "party": "C", "stance": -0.1, "sponsor": false},
        {"id": "l23", "name": "Member 23", "party": "C", "stance": 0.0, "sponsor": false},
        {"id": "l24", "name": "Member 24", "party": "C", "stance": -0.38, "sponsor": false},
        {"id": "l25", "name": "Member 25", "party": "C", "stance": 0.38, "sponsor": false}
      ]
    }
  },
  "brief": {
    "situation": "{$inputs.body_name} is considering a measure: {$inputs.bill}",
    "rules": "The presiding officer recognizes members. A sponsor introduces the measure, another member seconds it, members debate and may amend it, the chair calls the question, and members vote. Clone the engine to configure chamber-specific thresholds, quorum, floors, committees, vetoes, or multiple readings.",
    "roles": {
      "member": "Represent your constituency and party while exercising your own judgment under the body's procedure.",
      "presiding_officer": "Apply procedure neutrally, recognize speakers, and bring a sufficiently debated question to a vote."
    }
  },
  "clock": {"rounds": 5, "unit": "sitting"},
  "types": {
    "member": {"agent": true, "policy": "member_baseline", "props": {
      "party": {"type": "text", "default": ""},
      "stance": {"type": "number", "default": 0, "min": -1, "max": 1, "private": true, "description": "Current view of the measure, from -1 (against) to 1 (for); floor speeches move it."},
      "sponsor": {"type": "bool", "default": false},
      "initial_stance": {"type": "number", "default": 0, "min": -1, "max": 1, "private": true, "description": "Where the member started; their view stays partly anchored to it."},
      "openness": {"type": "number", "default": 0, "min": 0, "max": 1, "private": true, "description": "Share of the member's view that comes from the floor speeches."},
      "spoke_on": {"type": "int", "default": null, "private": true, "description": "The motion this member last spoke on (null before their first speech on a motion)."}
    }},
    "presiding_officer": {"agent": true, "policy": "chair_baseline"}
  },
  "population": [{"type": "member", "from": "$inputs.members", "id": "{$row.id}", "name": "{$row.name}", "props": {"party": "$row.party", "stance": "$row.stance", "sponsor": "$row.sponsor", "initial_stance": "$row.stance", "openness": "$uniform(0, 2 * $inputs.persuasion)"}}],
  "entities": {"chair": {"type": "presiding_officer", "name": "Presiding Officer"}},
  "mechanisms": {"speech_judge": {"kind": "host", "mode": "judge", "host": "judge", "visible": "false", "notify": false,
    "instructions": "Read one floor speech made in a debate on the measure given with it. Score which way it argues and how persuasive it is to a thoughtful listener, on its words alone.",
    "criteria": {"direction": {"description": "Which way the speech argues on the measure: -1 firmly against, 0 neutral or mixed, 1 firmly for.", "scale": [-1, 1]},
                 "strength": {"description": "How persuasive the speech is: 0 not at all, 1 compelling.", "scale": [0, 1]}}},
  "chamber": {
    "kind": "decision", "mode": "deliberation", "who": "member", "chair": "presiding_officer", "floor": true,
    "speaker_limit": 1, "passes": 100, "method": "majority", "quorum": 0.5, "question": "$inputs.bill",
    "motions": true, "second": true, "amendments": true, "private": false, "backstop": "vote", "ready_when_silent": false, "end": "decision"
  }},
  "defs": {
    "holds_floor": {"args": ["who"], "expr": "$world.chamber.floor == $who.id"},
    "open_motion": "$pending_motion() != null and $pending_motion().status == open",
    "heard_sum": {"args": ["who"], "expr": "$get($world.said, $who.party, 0) + (1 - $inputs.party_loyalty) * ($world.said_total - $get($world.said, $who.party, 0))", "description": "The stances of the floor speeches so far, summed as this member weighs them: a speech from another party counts 1 - party_loyalty of one from their own."},
    "heard_weight": {"args": ["who"], "expr": "$get($world.speakers, $who.party, 0) + (1 - $inputs.party_loyalty) * ($world.speeches - $get($world.speakers, $who.party, 0))", "description": "How many floor speeches this member has heard, weighed the same way."},
    "room_view": {"args": ["who"], "expr": "$heard_sum($who) / $heard_weight($who) if $heard_weight($who) > 0 else null", "description": "The average stance of the floor speeches as this member weighs them (null while nothing they weigh was said)."},
    "wants_floor": {"args": ["who"], "expr": "$pending_motion() == null and $who.sponsor or $pending_motion() != null and $who.spoke_on != $pending_motion().id", "description": "The mover asks for the floor to move the measure; every member asks to speak once on the question before the chamber."},
    "speeches": "$filter($records(chamber), $it.says == says)",
    "speech_stance": {"args": ["speech"], "expr": "$last($records(speech_judge)).scores.direction * $last($records(speech_judge)).scores.strength if $host_bound('judge') else $speech.author.stance", "description": "Where a speech pulls its listeners: the bound judge's reading of its words, else the speaker's own stance."}
  },
  "world": {
    "heard": {"type": "int", "default": 0, "description": "Entries of the chamber record whose persuasion has been applied."},
    "said": {"type": "map", "default": {}, "description": "Sum of the floor speeches' stances, by the speaker's party."},
    "speakers": {"type": "map", "default": {}, "description": "Floor speeches made, by the speaker's party."},
    "said_total": {"type": "number", "default": 0, "description": "Sum of the stances of every floor speech."},
    "speeches": {"type": "int", "default": 0, "description": "Floor speeches made."}
  },
  "triggers": [{"name": "persuasion", "when": "$len($records(chamber)) > $world.heard", "do": [
    "$world.heard = $len($records(chamber))", "$speech = $last($records(chamber))",
    {"if": "$speech.says == says", "then": [
      "$speaker = $speech.author", "$speaker.spoke_on = $speech.motion", "$party = $speaker.party",
      {"if": "$host_bound('judge')", "then": {"host": "speech_judge", "action": "judge", "text": "$'Measure: ' + $inputs.bill + ' Speech: ' + $speech.text", "subject": "$speaker"}},
      "$pull = $speech_stance($speech)",
      "$world.said = $merge($world.said, $dict([$party], $it, $get($world.said, $party, 0) + $pull))",
      "$world.speakers = $merge($world.speakers, $dict([$party], $it, $get($world.speakers, $party, 0) + 1))",
      "$world.said_total += $pull", "$world.speeches += 1",
      {"each": "member", "where": "$room_view($it) != null", "do": ["$it.stance = (1 - $it.openness) * $it.initial_stance + $it.openness * $room_view($it)"]}
    ]}
  ]}],
  "policies": {
    "chair_baseline": {"repeat": true, "rules": [
      {"when": "$world.chamber.floor == null and $pending_motion() == null and $any($world.chamber.hands, $entity($it).sponsor)", "do": "chamber_recognize", "with": {"who": "$pick($world.chamber.hands, $entity($it).sponsor)"}},
      {"when": "$world.chamber.floor == null and $pending_motion() != null and $len($world.chamber.hands) > 0", "do": "chamber_recognize", "with": {"who": "$choice($world.chamber.hands)"}},
      {"when": "$open_motion and $world.chamber.floor == null and $len($world.chamber.hands) == 0 and $pending_motion().speeches > 0", "do": "chamber_call_question"},
      {"do": "pass"}
    ]},
    "member_baseline": {"repeat": true, "rules": [
      {"when": "$world.chamber.phase == voting", "do": "chamber_vote", "with": {"choice": "$'yes' if $actor.stance >= 0 else 'no'"}},
      {"when": "$holds_floor($actor) and $pending_motion() == null and $actor.sponsor", "do": "chamber_propose", "with": {"text": "$inputs.bill"}},
      {"when": "$pending_motion() != null and $pending_motion().status == proposed and $pending_motion().mover != $actor.id and $actor.stance >= 0", "do": "chamber_second"},
      {"when": "$holds_floor($actor) and $open_motion", "do": "chamber_speak", "with": {"text": "$'I support the measure and its intended benefits.' if $actor.stance >= 0 else 'I oppose the measure because its costs and risks are too high.'"}},
      {"when": "$wants_floor($actor) and not ($actor.id in $world.chamber.hands) and not $holds_floor($actor)", "do": "chamber_raise_hand"},
      {"do": "pass"}
    ]}
  },
  "metrics": {
    "speeches": {"expr": "$len($speeches)"},
    "participation": {"expr": "$count(member, $it.id in $map($records(chamber), $it.author.id)) / $count(member) if $count(member) > 0 else null"}
  },
  "outputs": {
    "decided": {"type": "bool", "expr": "$len($decisions()) > 0"},
    "outcome": {"type": "text", "expr": "('passed' if $last($decisions()).passed else 'rejected') if $len($decisions()) > 0 else 'status_quo'", "description": "passed, rejected, or status_quo when nothing came to a vote."},
    "passed": {"type": "bool", "expr": "$last($decisions()).passed if $len($decisions()) > 0 else null"},
    "final_text": {"type": "text", "expr": "$last($decisions()).text if $len($decisions()) > 0 else null"},
    "yes": {"type": "int", "expr": "$last($decisions()).counts.yes if $len($decisions()) > 0 else 0"},
    "no": {"type": "int", "expr": "$last($decisions()).counts.no if $len($decisions()) > 0 else 0"},
    "speeches": {"type": "int", "expr": "$metrics.speeches"}
  }
}

{
  "fg_env": "2",
  "name": "Population Engine",
  "description": "A reusable sampled-population response engine. People independently choose among configurable responses with private inclinations and report confidence; the coded baseline responds from each person's inclination blurred by their uncertainty, stays undecided unless that leaning clearly outweighs its doubt (so the less confident answer undecided more often), and reports its confidence discounted by how likely it would give the same answer again, so outcomes vary across runs and aggregate across people and experiment runs.",
  "brief": {
    "situation": "A population is independently responding to one shared situation: {$inputs.question}",
    "rules": "Choose support, oppose, or undecided and state confidence. Responses are independent: you cannot see anyone else's response before submitting.",
    "roles": {"person": "Respond as this person, using the supplied persona and private inclination as context rather than as a command."}
  },

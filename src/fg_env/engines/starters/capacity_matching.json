{
  "fg_env": "1",
  "name": "Matching Engine",
  "description": "A reusable two-sided matching engine: applicants and selectors each privately rank the other side, and deferred acceptance produces a stable match within selector capacity.",
  "inputs": {
    "applicants": {
      "type": "table",
      "description": "quality is what selectors judge applicants on.",
      "columns": {"id": "text", "name": "text", "quality": "number"},
      "default": [
        {"id": "a1", "name": "Applicant 1", "quality": 0.99},
        {"id": "a2", "name": "Applicant 2", "quality": 0.68},
        {"id": "a3", "name": "Applicant 3", "quality": 0.76},
        {"id": "a4", "name": "Applicant 4", "quality": 1},
        {"id": "a5", "name": "Applicant 5", "quality": 0.71},
        {"id": "a6", "name": "Applicant 6", "quality": 0.56},
        {"id": "a7", "name": "Applicant 7", "quality": 0.45},
        {"id": "a8", "name": "Applicant 8", "quality": 0.58},
        {"id": "a9", "name": "Applicant 9", "quality": 0.38},
        {"id": "a10", "name": "Applicant 10", "quality": 0.74},
        {"id": "a11", "name": "Applicant 11", "quality": 0.65},
        {"id": "a12", "name": "Applicant 12", "quality": 0.5},
        {"id": "a13", "name": "Applicant 13", "quality": 0.38},
        {"id": "a14", "name": "Applicant 14", "quality": 0.54},
        {"id": "a15", "name": "Applicant 15", "quality": 0.54},
        {"id": "a16", "name": "Applicant 16", "quality": 0.56},
        {"id": "a17", "name": "Applicant 17", "quality": 0.46},
        {"id": "a18", "name": "Applicant 18", "quality": 0.71},
        {"id": "a19", "name": "Applicant 19", "quality": 0.85},
        {"id": "a20", "name": "Applicant 20", "quality": 0.47},
        {"id": "a21", "name": "Applicant 21", "quality": 0.54},
        {"id": "a22", "name": "Applicant 22", "quality": 0.49},
        {"id": "a23", "name": "Applicant 23", "quality": 0.7},
        {"id": "a24", "name": "Applicant 24", "quality": 0.56},
        {"id": "a25", "name": "Applicant 25", "quality": 0.55},
        {"id": "a26", "name": "Applicant 26", "quality": 0.67},
        {"id": "a27", "name": "Applicant 27", "quality": 0.37},
        {"id": "a28", "name": "Applicant 28", "quality": 0.46},
        {"id": "a29", "name": "Applicant 29", "quality": 0.52},
        {"id": "a30", "name": "Applicant 30", "quality": 0.33},
        {"id": "a31", "name": "Applicant 31", "quality": 0.54},
        {"id": "a32", "name": "Applicant 32", "quality": 0.39},
        {"id": "a33", "name": "Applicant 33", "quality": 0.6},
        {"id": "a34", "name": "Applicant 34", "quality": 0.98},
        {"id": "a35", "name": "Applicant 35", "quality": 0.84},
        {"id": "a36", "name": "Applicant 36", "quality": 0.59},
        {"id": "a37", "name": "Applicant 37", "quality": 0.91},
        {"id": "a38", "name": "Applicant 38", "quality": 0.59},
        {"id": "a39", "name": "Applicant 39", "quality": 0.78},
        {"id": "a40", "name": "Applicant 40", "quality": 0.42}
      ]
    },
    "selectors": {
      "type": "table",
      "description": "appeal is how attractive a selector is to applicants on average; minimum_quality is its private bar.",
      "columns": {"id": "text", "name": "text", "capacity": "int", "appeal": "number", "minimum_quality": "number"},
      "default": [
        {"id": "s1", "name": "Selector 1", "capacity": 4, "appeal": 0.77, "minimum_quality": 0.52},
        {"id": "s2", "name": "Selector 2", "capacity": 3, "appeal": 0.69, "minimum_quality": 0.57},
        {"id": "s3", "name": "Selector 3", "capacity": 6, "appeal": 0.4, "minimum_quality": 0.59},
        {"id": "s4", "name": "Selector 4", "capacity": 4, "appeal": 0.83, "minimum_quality": 0.55},
        {"id": "s5", "name": "Selector 5", "capacity": 4, "appeal": 0.59, "minimum_quality": 0.35},
        {"id": "s6", "name": "Selector 6", "capacity": 6, "appeal": 0.32, "minimum_quality": 0.58},
        {"id": "s7", "name": "Selector 7", "capacity": 4, "appeal": 0.86, "minimum_quality": 0.59},
        {"id": "s8", "name": "Selector 8", "capacity": 3, "appeal": 0.72, "minimum_quality": 0.3}
      ]
    },
    "taste": {"type": "number", "default": 0.2, "min": 0, "description": "How much each coded participant's judgment strays from shared appeal and quality (the spread of personal taste); 0 = everyone ranks alike."}
  },
  "brief": {
    "situation": "Applicants and selectors are being matched.",
    "rules": "Everyone privately ranks the other side, best first; anyone left off your ranking is unacceptable to you. Deferred acceptance then makes a stable match: no applicant and selector who both prefer each other are left apart, and no selector takes more applicants than its capacity.",
    "roles": {
      "applicant": "Rank the selectors you would accept, best first.",
      "selector": "Rank the applicants you would accept, best first, according to your criteria."
    }
  },
  "clock": {"rounds": 1, "unit": "cycle"},
  "types": {
    "applicant": {"agent": true, "policy": "applicant_baseline", "props": {
      "quality": {"type": "number", "default": 0}
    }},
    "selector": {"agent": true, "policy": "selector_baseline", "props": {
      "capacity": {"type": "int", "default": 1},
      "appeal": {"type": "number", "default": 0},
      "minimum_quality": {"type": "number", "default": 0, "private": true}
    }}
  },
  "population": [
    {"type": "applicant", "from": "$inputs.applicants", "id": "{$row.id}", "name": "{$row.name}", "props": {"quality": "$row.quality"}},
    {"type": "selector", "from": "$inputs.selectors", "id": "{$row.id}", "name": "{$row.name}", "props": {"capacity": "$row.capacity", "appeal": "$row.appeal", "minimum_quality": "$row.minimum_quality"}}
  ],
  "mechanisms": {"placement": {"kind": "groups", "mode": "matching", "who": "applicant", "to": "selector", "seats": "$it.capacity"}},
  "views": {
    "selectors": {"for": "applicant", "title": "Selectors", "of": "selector", "show": "{name}: appeal {appeal|2}; capacity {capacity}"},
    "selector_position": {"for": "selector", "show": "Your capacity is {capacity}; your private minimum quality is {minimum_quality|2}."},
    "applicants": {"for": "selector", "title": "Applicants", "of": "applicant", "show": "{name}: quality {quality|2}"}
  },
  "policies": {
    "applicant_baseline": {"rules": [{"do": "placement_rank_applicant", "with": {"ranking": "$top(selector, $it.appeal + $normal(0, $inputs.taste))"}}]},
    "selector_baseline": {"rules": [{"do": "placement_rank_selector", "with": {"ranking": "$top($filter(applicant, $it.quality >= $actor.minimum_quality), $it.quality + $normal(0, $inputs.taste))"}}]}
  },
  "metrics": {"match_rate": {"expr": "$count(applicant, $it.placement_match != '') / $count(applicant) if $count(applicant) > 0 else null"}},
  "outputs": {
    "unmatched_applicants": {"type": "int", "expr": "$count(applicant, $it.placement_match == '')"},
    "match_rate": {"type": "number", "expr": "$metrics.match_rate"},
    "first_choice_rate": {"type": "number", "expr": "$count(applicant, $it.placement_match != '' and $it.placement_match == $first($it.placement_prefs)) / $count(applicant) if $count(applicant) > 0 else null", "description": "Share of applicants matched to the selector they ranked first."},
    "unused_capacity": {"type": "int", "expr": "$sum(selector, $it.capacity - $len($it.placement_matches))"}
  }
}

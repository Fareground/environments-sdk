{
  "name": "Social Media Discourse",
  "description": "Social media discussion simulation around an event or topic. Users post opinions, reply, share, and fact-check content as discourse unfolds across a platform. Viral dynamics and reputation systems shape how information spreads.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "discourse",
        "description": "Users post, reply, share, and engage with content around the topic",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "User",
      "role": "agent",
      "description": "A social media user who posts opinions, engages with content, and participates in online discourse",
      "properties": [
        {
          "name": "follower_count",
          "type": "float",
          "default": 100.0,
          "min_value": 0.0,
          "max_value": 10000000.0,
          "description": "Number of followers this user has",
          "hidden": false
        },
        {
          "name": "credibility",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How trustworthy and credible this user is perceived to be",
          "hidden": true
        },
        {
          "name": "emotional_reactivity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How strongly the user reacts emotionally to content",
          "hidden": true
        },
        {
          "name": "expertise",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Domain expertise relevant to the discussion topic",
          "hidden": true
        },
        {
          "name": "polarization",
          "type": "float",
          "default": 0.0,
          "min_value": -1.0,
          "max_value": 1.0,
          "description": "Political or ideological leaning (-1 = strongly one side, 1 = strongly other side)",
          "hidden": true
        },
        {
          "name": "engagement_drive",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How motivated the user is to actively participate in discussions",
          "hidden": true
        }
      ]
    }
  ],
  "resource_types": [],
  "relation_types": [
    {
      "name": "follows",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Whether one user follows another and how closely they pay attention to their content"
    },
    {
      "name": "trust",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How much one user trusts another's posts and opinions"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "User"
      ],
      "visible_properties": {
        "User": [

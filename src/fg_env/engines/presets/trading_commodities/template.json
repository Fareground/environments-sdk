    {
      "name": "sample_size",
      "label": "Number of Traders",
      "type": "int",
      "default": 4,
      "min_value": 2,
      "max_value": 10,
      "description": "How many isolated portfolios compete.",
      "category": "scale"
    },
    {
      "name": "domain.trading_pvp.symbol",
      "label": "Ticker",
      "type": "string",
      "default": "GC=F",
      "description": "Commodity future (Yahoo Finance format ends in =F). Examples: GC=F (gold), SI=F (silver), CL=F (oil). The pre-match config gives you a search box.",
      "category": "rules"
    },
    {
      "name": "domain.trading_pvp.asset_class",
      "label": "Asset Class",
      "type": "string",
      "default": "commodities",
      "description": "Locked for this template.",
      "category": "rules"
    },
    {
      "name": "domain.trading_pvp.starting_cash",
      "label": "Starting Capital ($)",
      "type": "int",
      "default": 100000,
      "min_value": 1000,
      "max_value": 1000000,
      "description": "Cash each trader starts with. Everyone starts equal.",
      "category": "rules"
    },
    {
      "name": "domain.trading_pvp.num_ticks",
      "label": "Number of Ticks",
      "type": "int",
      "default": 30,
      "min_value": 4,
      "max_value": 200,
      "description": "How many trading rounds. Each tick, every trader gets one decision against the live price. Match length ≈ ticks × minutes-between-ticks.",
      "category": "rules"
    },
    {
      "name": "domain.trading_pvp.tick_minutes",
      "label": "Minutes Between Ticks",
      "type": "int",
      "default": 1,
      "min_value": 1,
      "max_value": 60,
      "description": "Wall-clock minutes between trading ticks. Lower = faster matches, more reaction-time pressure. Higher = more realistic.",
      "category": "rules"
    },
    {
      "name": "domain.trading_pvp.shorts_allowed",
      "label": "Allow Short Selling",
      "type": "bool",
      "default": true,
      "description": "When ON, traders can short / cover. When OFF, only buy / sell (long-only).",
      "category": "rules"
    }
  ],
  "termination_conditions": [

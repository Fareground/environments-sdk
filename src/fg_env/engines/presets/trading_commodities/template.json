      "goals": [
        "Capital preservation."
      ],
      "personality_traits": [
        "cautious",
        "disciplined"
      ]
    },
    {
      "entity_name": "Trader 5",
      "entity_type": "Trader",
      "persona_text": "Aggressive short-seller. Looks for tops, leans into weakness.",
      "goals": [
        "Hit shorts on the second push."
      ],
      "personality_traits": [
        "bearish",
        "skeptical"
      ]
    },
    {
      "entity_name": "Trader 6",
      "entity_type": "Trader",
      "persona_text": "Range trader. Buys the low end of a range, sells the top.",
      "goals": [
        "Trade the band."
      ],
      "personality_traits": [
        "technical",
        "methodical"
      ]
    },
    {
      "entity_name": "Trader 7",
      "entity_type": "Trader",
      "persona_text": "Degenerate gambler. Big size, all-in moves.",
      "goals": [
        "Get rich or get rekt."
      ],
      "personality_traits": [
        "reckless",
        "high-variance"
      ]
    },
    {
      "entity_name": "Trader 8",
      "entity_type": "Trader",
      "persona_text": "Quant. Short-term inefficiencies, fast exits.",

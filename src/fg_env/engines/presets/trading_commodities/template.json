          "default": 0.0,
          "description": "Cumulative realized P&L.",
          "hidden": false
        },
        {
          "name": "portfolio_value",
          "type": "float",
          "default": 100000.0,
          "description": "cash + position × last_price.",
          "hidden": false
        },
        {
          "name": "trades_made",
          "type": "int",
          "default": 0,
          "description": "Total orders submitted.",
          "hidden": false

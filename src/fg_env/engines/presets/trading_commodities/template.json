  "personas": [
    {
      "entity_name": "Trader 1",
      "entity_type": "Trader",
      "persona_text": "Momentum crypto trader. Buys breakouts, cuts losers fast.",
      "goals": [
        "Catch the directional move."
      ],
      "personality_traits": [
        "aggressive",
        "tape-reader"
      ]
    },
    {
      "entity_name": "Trader 2",
      "entity_type": "Trader",
      "persona_text": "Mean-reversion scalper. Fades extreme moves expecting a snap-back.",
      "goals": [
        "Buy panic, sell euphoria."
      ],
      "personality_traits": [
        "contrarian",
        "patient"
      ]
    },
    {
      "entity_name": "Trader 3",

{
  "name": "Dating App",
  "description": "Online dating simulation. Users build profiles, swipe, match, message, meet up, or ghost as attraction, intent, and effort collide. Matching algorithms, gender ratios, and app culture shape who connects and who gets left on read.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "matching",
        "description": "Users discover profiles, swipe, and form (or miss) matches",
        "active_roles": []
      },
      {
        "name": "conversation",
        "description": "Matched users message, escalate, ghost, or arrange to meet",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "User",
      "role": "agent",
      "description": "A dating-app user with a profile, preferences, and dating intent who swipes, matches, messages, and meets",
      "properties": [
        {
          "name": "attractiveness",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Perceived physical/photo attractiveness that drives inbound interest",
          "hidden": true
        },
        {
          "name": "profile_quality",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How compelling the profile is beyond looks — prompts, bio, wit",
          "hidden": false
        },
        {
          "name": "desirability_score",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "The app's internal Elo-style ranking that gates who this user is shown to",
          "hidden": true
        },
        {
          "name": "selectivity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How picky the user is — high selectivity swipes right rarely",
          "hidden": true
        },
        {
          "name": "intent_seriousness",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Casual (0) vs. serious long-term relationship (1) intent",
          "hidden": true
        },
        {
          "name": "effort",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How much energy the user puts into messages and follow-through",
          "hidden": true
        },
        {
          "name": "authenticity",
          "type": "float",
          "default": 0.8,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How honestly the profile represents the real person (low = catfish/misrepresentation)",
          "hidden": true
        },
        {
          "name": "response_rate",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Likelihood the user replies to a new message rather than leaving it on read",
          "hidden": false
        },
        {
          "name": "ghosting_tendency",
          "type": "float",
          "default": 0.3,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Propensity to go silent mid-conversation instead of closing it out",
          "hidden": true
        },
        {
          "name": "match_count",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": 100000.0,
          "description": "Number of mutual matches accumulated so far",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [],
  "relation_types": [
    {
      "name": "liked",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "One user swiped right on / liked another (directional interest before a match)"
    },
    {
      "name": "matched",
      "symmetric": true,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Mutual right-swipe — both users can now message each other"
    },
    {
      "name": "conversation",
      "symmetric": true,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "An active, ongoing message thread and how warm it is"
    },
    {
      "name": "attraction",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How drawn one user feels to another as they interact"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "User"
      ],
      "visible_properties": {
        "User": [
          "profile_quality",
          "response_rate",
          "match_count"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": []
    }
  ],
  "actions": [
    {
      "name": "swipe_right",
      "description": "Like a profile — express interest. A match forms only if the other user likes back.",
      "actor_type": "User",
      "target_type": "User",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",

{
  "name": "Consumer Focus Group",
  "description": "Consumer focus group and market research simulation where participants share opinions, debate preferences, and react to product concepts. Group dynamics emerge as vocal participants influence quieter ones, brand loyalists clash with critics, and consensus forms or fractures around key features.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "discussion",
        "description": "Consumers share opinions, agree or disagree with each other, rate features, and suggest improvements",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Consumer",
      "role": "agent",
      "description": "A consumer participating in a focus group discussion, offering opinions and reacting to others based on personal preferences and confidence",
      "properties": [
        {
          "name": "brand_awareness",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Familiarity with the brand and its product lineup",
          "hidden": false
        },
        {
          "name": "price_sensitivity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How much price influences purchasing decisions",
          "hidden": true
        },
        {
          "name": "quality_preference",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Importance placed on build quality, materials, and durability",
          "hidden": true
        },
        {
          "name": "trend_following",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Tendency to adopt products that are popular or trending",
          "hidden": true
        },
        {
          "name": "vocal_confidence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness and ability to speak up and assert opinions in a group",
          "hidden": false
        },
        {
          "name": "satisfaction",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Overall satisfaction with the product or concept being discussed",
          "hidden": true
        }
      ]
    }
  ],
  "resource_types": [],
  "relation_types": [
    {
      "name": "agreement",
      "symmetric": true,
      "default_value": 0.5,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How much two consumers agree on product preferences and opinions"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Consumer"
      ],
      "visible_properties": {
        "Consumer": [
          "brand_awareness",
          "vocal_confidence"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": []
    }
  ],
  "actions": [
    {
      "name": "share_opinion",
      "description": "Openly share thoughts and feelings about the product or concept being discussed",
      "actor_type": "Consumer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.02,
          "description": "Speaking up builds confidence over time"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "agree_with",
      "description": "Express agreement with another participant's point of view",
      "actor_type": "Consumer",
      "target_type": "Consumer",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.01,
          "description": "Agreeing is a low-risk way to participate"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.02,
          "description": "Being agreed with encourages further participation"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "disagree_with",
      "description": "Push back against another participant's view with a counterargument",
      "actor_type": "Consumer",
      "target_type": "Consumer",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_field": "vocal_confidence",
        "defender_field": "vocal_confidence"
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.03,
          "description": "Winning a debate boosts assertiveness"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "vocal_confidence",
          "value": -0.02,
          "description": "Being effectively countered reduces confidence"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": -0.02,
          "description": "Losing a debate dampens willingness to speak"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.02,
          "description": "Successfully defending a point reinforces confidence"
        }
      ]
    },
    {
      "name": "rate_feature",
      "description": "Provide a structured rating on a specific product feature",
      "actor_type": "Consumer",
      "target_type": null,
      "parameters": [
        {
          "name": "rating",
          "type": "float",
          "default": 3.0,
          "min_value": 1.0,
          "max_value": 5.0,
          "description": "Rating from 1 (poor) to 5 (excellent)"
        }
      ],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "brand_awareness",
          "value": 0.02,
          "description": "Rating features deepens product familiarity"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "suggest_improvement",
      "description": "Propose a specific change or enhancement to the product",
      "actor_type": "Consumer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "quality_preference",
        "difficulty": 0.3
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": 0.03,
          "description": "Well-received suggestion boosts confidence"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "satisfaction",
          "value": 0.02,
          "description": "Feeling heard increases satisfaction"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "vocal_confidence",
          "value": -0.01,
          "description": "Ignored suggestion slightly reduces confidence"
        }
      ]
    },
    {
      "name": "compare_to_competitor",
      "description": "Draw a comparison between the product and a competing alternative",
      "actor_type": "Consumer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "brand_awareness",
          "value": 0.03,
          "description": "Comparing products demonstrates and reinforces market knowledge"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "stay_silent",
      "description": "Choose not to speak, observing the discussion without contributing",
      "actor_type": "Consumer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {

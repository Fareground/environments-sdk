{
  "name": "Belief Cascade",
  "description": "How beliefs, rumors, reputations, ideologies, or behaviors spread through a network of agents — with seeders pushing the message, counter-spreaders pushing back, and a population deciding what to adopt. Run with different content types (misinformation, cult ideology, rumor, reputation attack, conspiracy, product adoption) and watch S-curves, tipping points, recovery dynamics, and divergent equilibria.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "exposure",
        "description": "Agents observe what their connections believe and share",
        "active_roles": []
      },
      {
        "name": "decision",
        "description": "Agents decide whether to adopt, reject, share, or counter the spreading content",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Agent",
      "role": "agent",
      "description": "A member of the population, exposed to spreading content via their network connections",
      "properties": [
        {
          "name": "belief_level",
          "type": "float",
          "default": 0.0,
          "min_value": -1.0,
          "max_value": 1.0,
          "description": "Current belief in the spreading content (-1 = actively rejects, 0 = neutral, +1 = strong adopter)",
          "hidden": false
        },
        {
          "name": "credulity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Predisposition to accept new claims without verification",
          "hidden": false
        },
        {
          "name": "social_influence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How much this agent influences others when they share",
          "hidden": false
        },
        {
          "name": "skepticism",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Resistance to socially-driven belief change; ability to evaluate claims critically",
          "hidden": false
        },
        {
          "name": "conformity_pressure",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Susceptibility to peer-pressure / social conformity",
          "hidden": false
        },
        {
          "name": "has_shared",
          "type": "bool",
          "default": false,
          "description": "Whether this agent has actively shared the content",
          "hidden": false
        },
        {
          "name": "exit_cost",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Personal cost of leaving the belief once adopted (high for cults, low for transient rumors)",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "attention",
      "conservation": false,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Aggregate attention currently focused on the spreading content"
    }
  ],
  "relation_types": [
    {
      "name": "follows",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Directional social tie — A follows B means A sees B's shares"
    },
    {
      "name": "trusts",
      "symmetric": false,
      "default_value": 0.5,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Trust weight on B's claims when A is exposed to them"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Agent"
      ],
      "visible_properties": {
        "Agent": [
          "belief_level",
          "credulity",
          "social_influence",
          "skepticism",
          "conformity_pressure",
          "has_shared"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "attention"
      ]
    }
  ],
  "actions": [
    {
      "name": "adopt_belief",
      "description": "Accept the spreading content as true and shift belief level upward",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "credulity",
        "difficulty": 0.4
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "belief_level",
          "value": 0.25,
          "description": "Belief strengthens after evaluation"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "skepticism",
          "value": 0.02,
          "description": "Failed to convince oneself — slightly more skeptical"
        }
      ]
    },
    {
      "name": "reject_belief",
      "description": "Push belief level downward — actively reject the spreading content",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "skepticism",
        "difficulty": 0.4
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "belief_level",
          "value": -0.25,
          "description": "Belief weakens after critical evaluation"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "share",
      "description": "Broadcast the content to your network — amplifies spread to followers",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "social_influence",
        "difficulty": 0.3
      },
      "message_action": false,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "has_shared",
          "value": true,
          "description": "Agent becomes a propagator"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "social_influence",
          "value": 0.02,
          "description": "Sharing builds influence"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "counter_speak",
      "description": "Publicly push back against the content — try to reduce others' belief",
      "actor_type": "Agent",
      "target_type": "Agent",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "skepticism",
        "defender_skill": "credulity"
      },
      "message_action": false,
      "effects_on_success": [
        {
          "target": "target",
          "operation": "add",
          "field": "belief_level",
          "value": -0.15,
          "description": "Counter-speech weakens target's belief"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "social_influence",
          "value": -0.03,
          "description": "Failed counter loses social capital"
        }
      ]
    },
    {
      "name": "private_doubt",
      "description": "Internally question the belief but don't speak up publicly",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "belief_level",
          "value": -0.05,
          "description": "Private skepticism slowly grows"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "conform",
      "description": "Adopt the belief because your peers do — pure social conformity",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "conformity_pressure",
        "difficulty": 0.4
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "belief_level",
          "value": 0.2,
          "description": "Conformed to perceived majority view"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "exit_belief",
      "description": "Abandon a previously held belief (high exit_cost makes this expensive — relevant for cults)",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "gte",
          "field": "belief_level",
          "value": 0.3
        }
      ],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "skepticism",
        "difficulty": 0.6
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "belief_level",
          "value": -0.2,
          "description": "Exit accomplished — actively rejects"
        },
        {
          "target": "actor",
          "operation": "set",
          "field": "has_shared",
          "value": false,
          "description": "No longer propagates"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "observe",
      "description": "Watch and listen without acting — gather more information from the network",
      "actor_type": "Agent",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [],
      "effects_on_failure": []
    }
  ],

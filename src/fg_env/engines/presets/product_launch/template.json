          "value": 0.05,
          "description": "Being convinced increases enthusiasm"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "enthusiasm",
          "value": -0.01,
          "description": "Rejection slightly dampens recommender's spirit"
        },
        {
          "target": "target",
          "operation": "add",

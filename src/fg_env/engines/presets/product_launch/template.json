{
  "name": "Product Launch",
  "description": "Product launch simulation where company teams pitch, promote, and iterate on a new product while consumers test, evaluate, and spread word-of-mouth. Emergent adoption curves and market reception arise from individual stakeholder interactions.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "launch_cycle",
        "description": "Stakeholders pitch, test, promote, purchase, and give feedback on the product",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Stakeholder",
      "role": "agent",
      "description": "A participant in the product launch ecosystem — could be a company insider, early adopter, consumer, or industry observer",
      "properties": [
        {
          "name": "budget",
          "type": "float",
          "default": 500.0,
          "min_value": 0.0,
          "max_value": 100000.0,
          "description": "Available funds for purchasing or marketing",
          "hidden": false
        },
        {
          "name": "market_knowledge",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Understanding of the market landscape and competitor products",
          "hidden": false
        },
        {
          "name": "enthusiasm",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Excitement and positive energy about the product",
          "hidden": true
        },
        {
          "name": "skepticism",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Tendency to doubt claims and demand proof",
          "hidden": true
        },
        {
          "name": "influence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to sway others' opinions and purchasing decisions",
          "hidden": false
        },
        {
          "name": "brand_loyalty",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Attachment to the brand behind the product",
          "hidden": true
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "revenue",
      "conservation": false,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Revenue generated from product sales and engagement"
    }
  ],
  "relation_types": [
    {
      "name": "trust",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How much one stakeholder trusts another's opinions and recommendations"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Stakeholder"
      ],
      "visible_properties": {
        "Stakeholder": [
          "budget",
          "market_knowledge",
          "influence"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "revenue"
      ]
    }
  ],
  "actions": [
    {
      "name": "pitch_product",
      "description": "Present the product's value proposition to generate excitement and interest",
      "actor_type": "Stakeholder",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "enthusiasm",
        "difficulty": 0.4
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "enthusiasm",
          "value": 0.03,
          "description": "Successful pitch reinforces own excitement"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "influence",
          "value": 0.02,
          "description": "Good pitches build credibility"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "enthusiasm",
          "value": -0.02,
          "description": "Failed pitch dampens enthusiasm"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "influence",
          "value": -0.01,
          "description": "Poor pitch slightly reduces credibility"
        }
      ]
    },
    {
      "name": "test_product",

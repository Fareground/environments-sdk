{
  "name": "Brainstorming Session",
  "description": "Team brainstorming and ideation simulation where team members propose ideas, build on each other's contributions, critique proposals, and work toward creative solutions. Models group dynamics including energy, seniority, and interpersonal rapport.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "ideation",
        "description": "Team members brainstorm, propose ideas, critique, and build on each other's contributions",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "TeamMember",
      "role": "agent",
      "description": "A team member participating in a brainstorming session, contributing ideas and engaging with others' proposals",
      "properties": [
        {
          "name": "creativity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to generate novel and original ideas",
          "hidden": true
        },
        {
          "name": "domain_knowledge",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Depth of expertise in the relevant domain",
          "hidden": false
        },
        {
          "name": "communication",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to articulate ideas clearly and persuasively",
          "hidden": false
        },
        {
          "name": "openness",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness to consider and build on others' ideas",
          "hidden": true
        },
        {
          "name": "energy",
          "type": "float",
          "default": 80.0,
          "min_value": 0.0,
          "max_value": 100.0,
          "description": "Current energy and enthusiasm level",
          "hidden": false
        },
        {
          "name": "seniority",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Level of seniority and organizational influence",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "ideas",
      "conservation": false,

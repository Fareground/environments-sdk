          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Soft power and ability to shape international consensus",
          "hidden": false
        },
        {
          "name": "internal_stability",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Domestic political stability and social cohesion",
          "hidden": false
        },
        {
          "name": "nuclear_capability",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Nuclear weapons capability and delivery systems",
          "hidden": true
        },
        {
          "name": "public_opinion",
          "type": "float",
          "default": 0.0,
          "min_value": -1.0,
          "max_value": 1.0,
          "description": "Domestic public sentiment from dovish (-1) to hawkish (1)",
          "hidden": false
        }
      ]
    }
  ],

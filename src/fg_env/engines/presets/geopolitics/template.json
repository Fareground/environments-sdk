          "max_value": 1.0,
          "description": "Conventional military strength and projection capability",
          "hidden": false
        },
        {
          "name": "economic_strength",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Overall economic output and resilience",
          "hidden": false
        },
        {

  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "diplomacy",
        "description": "Nations negotiate, posture, and take strategic actions on the world stage",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Nation",
      "role": "agent",
      "description": "A sovereign nation-state that pursues strategic interests through military, economic, and diplomatic means",
      "properties": [
        {
          "name": "military_power",
          "type": "float",
          "default": 0.5,

{
  "name": "Sales Call",
  "description": "A persuasion call between one (or a small team of) seller(s) and a prospect. The seller works through rapport-building, discovery, value pitch, objection handling, and closing — while the prospect's attention depletes and trust evolves. Customizable for outbound sales, customer save, fundraising, political canvassing, recruiting, and other 1-on-1 persuasion contexts.",
  "scenario_type": "social",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "call",
        "description": "The call unfolds turn-by-turn between seller and prospect",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Seller",
      "role": "agent",
      "description": "The party trying to persuade the prospect — has a quota, a script, and a value proposition",
      "properties": [
        {
          "name": "rapport_skill",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to build personal connection quickly",
          "hidden": false
        },
        {
          "name": "discovery_skill",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to uncover the prospect's actual needs through questions",
          "hidden": false
        },
        {
          "name": "objection_handling",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to address concerns without sounding defensive",
          "hidden": false
        },
        {
          "name": "closing_skill",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to ask for the commitment at the right moment",
          "hidden": false
        },
        {
          "name": "product_knowledge",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Depth of understanding of what they're selling",
          "hidden": false
        },
        {
          "name": "pushiness",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Aggressiveness — drives speed but burns trust",
          "hidden": false
        },
        {
          "name": "calls_today",
          "type": "int",
          "default": 0,
          "min_value": 0,
          "max_value": null,
          "description": "How many calls this seller has done today (fatigue indicator)",
          "hidden": false
        }
      ]
    },
    {
      "name": "Prospect",
      "role": "agent",
      "description": "The party being persuaded — has limited attention, latent needs, and predisposed skepticism",
      "properties": [
        {
          "name": "attention",
          "type": "float",
          "default": 1.0,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Remaining patience to stay on the call — depletes each turn",
          "hidden": false
        },
        {
          "name": "trust",
          "type": "float",
          "default": 0.3,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Current trust in the seller",
          "hidden": false
        },
        {
          "name": "need_intensity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How acutely the prospect needs what's being offered (often hidden from them)",
          "hidden": false
        },
        {
          "name": "skepticism",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Default suspicion toward sales pitches",
          "hidden": false
        },
        {
          "name": "budget_authority",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to actually approve a purchase decision",
          "hidden": false
        },
        {
          "name": "objections_raised",
          "type": "int",
          "default": 0,
          "min_value": 0,
          "max_value": null,
          "description": "Count of objections raised so far",
          "hidden": false
        },
        {
          "name": "interest_level",
          "type": "float",
          "default": 0.0,
          "min_value": -1.0,
          "max_value": 1.0,
          "description": "Current level of interest (-1=hostile, 0=neutral, +1=ready to buy)",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "talk_time",
      "conservation": false,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Cumulative seconds spent on the call"
    }
  ],
  "relation_types": [
    {
      "name": "rapport",
      "symmetric": true,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Personal connection between seller and prospect"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Seller",
        "Prospect"
      ],
      "visible_properties": {
        "Seller": [
          "rapport_skill",
          "discovery_skill",
          "objection_handling",
          "closing_skill",
          "product_knowledge",
          "pushiness"
        ],
        "Prospect": [
          "attention",
          "trust",
          "skepticism",
          "budget_authority",
          "objections_raised",
          "interest_level"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "talk_time"
      ]
    }
  ],
  "actions": [
    {
      "name": "build_rapport",
      "description": "Open with small talk, find common ground, warm the conversation",
      "actor_type": "Seller",
      "target_type": "Prospect",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "rapport_skill",
        "difficulty": 0.3
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "target",
          "operation": "add",
          "field": "trust",
          "value": 0.1,
          "description": "Rapport built — prospect warms up"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "attention",
          "value": 0.05,
          "description": "Engaging opener buys you time"
        }
      ],
      "effects_on_failure": [
        {
          "target": "target",
          "operation": "add",
          "field": "attention",
          "value": -0.05,
          "description": "Awkward small talk wastes time"
        }
      ]
    },
    {
      "name": "ask_discovery_question",
      "description": "Ask open-ended questions to uncover the prospect's real needs and pain points",
      "actor_type": "Seller",
      "target_type": "Prospect",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "discovery_skill",
        "difficulty": 0.4
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "discovery_skill",
          "value": 0.01,
          "description": "Practice sharpens the skill"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "trust",
          "value": 0.05,
          "description": "Feeling heard builds trust"
        }
      ],
      "effects_on_failure": [
        {
          "target": "target",
          "operation": "add",
          "field": "skepticism",
          "value": 0.05,
          "description": "Question felt invasive or scripted"
        }
      ]
    },
    {
      "name": "pitch_value",
      "description": "Present the value proposition tailored to the prospect's stated needs",
      "actor_type": "Seller",
      "target_type": "Prospect",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "product_knowledge",
        "defender_skill": "skepticism"

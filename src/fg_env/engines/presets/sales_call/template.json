      "message_action": true,
      "effects_on_success": [
        {
          "target": "target",
          "operation": "add",
          "field": "interest_level",
          "value": 0.2,
          "description": "Compelling pitch raises interest"
        }
      ],
      "effects_on_failure": [
        {
          "target": "target",
          "operation": "add",
          "field": "interest_level",
          "value": -0.1,
          "description": "Pitch fell flat"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "attention",
          "value": -0.1,
          "description": "Generic pitch loses attention"
        }
      ]
    },
    {
      "name": "handle_objection",

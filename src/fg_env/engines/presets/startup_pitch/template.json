      "actor_type": "Participant",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "business_acumen",
        "difficulty": 0.4
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "business_acumen",
          "value": 0.01,
          "description": "Crafting terms sharpens deal-making skill"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "negotiate_terms",
      "description": "Negotiate the terms of an investment deal — valuation, equity, board seats, and provisions",
      "actor_type": "Participant",
      "target_type": "Participant",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "business_acumen",
        "defender_skill": "business_acumen"
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "business_acumen",
          "value": 0.02,
          "description": "Winning negotiation builds deal-making confidence"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "business_acumen",
          "value": -0.01,
          "description": "Losing negotiation ground is humbling"
        }
      ]
    },
    {
      "name": "due_diligence",
      "description": "Conduct technical and business due diligence on a startup or opportunity",
      "actor_type": "Participant",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "technical_expertise",
        "difficulty": 0.45
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "domain_knowledge",
          "value": 0.03,
          "description": "Thorough due diligence deepens domain expertise"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "invest",
      "description": "Commit capital to a startup, finalizing the investment (targets the founder being backed; final, one commitment per investor)",
      "actor_type": "Participant",
      "target_type": "Participant",
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "invested",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "invested",
          "value": true,
          "description": "Investor's commitment is final"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "commitments",
          "value": 1,
          "description": "The founder's round gains a committed investor"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "investment_committed",
          "description": "An investor committed capital to the round"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "pass",
      "description": "Decline to invest — pass on the opportunity",
      "actor_type": "Participant",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "invested",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "passed",
          "value": true,
          "description": "The pass is on the record"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "investor_passed",
          "description": "An investor formally passed on the round"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "counter_offer",
      "description": "Respond to a term sheet with a counter-proposal on different terms",
      "actor_type": "Participant",
      "target_type": "Participant",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "business_acumen",
        "defender_skill": "business_acumen"

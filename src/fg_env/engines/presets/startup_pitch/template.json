{
  "name": "Startup Pitch",
  "description": "Startup pitch and VC funding simulation. Founders pitch their startups to investors who ask probing questions, conduct due diligence, and decide whether to invest. Participants negotiate terms, form syndicates, and compete for the best deals.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "pitch_and_invest",
        "description": "Founders pitch, investors evaluate, ask questions, negotiate terms, and make investment decisions",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Participant",
      "role": "agent",
      "description": "A startup ecosystem participant — founder seeking funding or investor evaluating opportunities",
      "properties": [
        {
          "name": "capital",
          "type": "float",
          "default": 100.0,
          "min_value": 0.0,
          "max_value": 100000000.0,
          "description": "Available capital for investment or startup runway",
          "hidden": false
        },
        {
          "name": "technical_expertise",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Depth of technical knowledge and ability to evaluate technology",
          "hidden": false
        },
        {
          "name": "business_acumen",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Understanding of business models, markets, and financial strategy",
          "hidden": false
        },
        {
          "name": "charisma",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to inspire, persuade, and captivate an audience",
          "hidden": false
        },
        {
          "name": "risk_appetite",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness to take on high-risk high-reward investments",
          "hidden": false
        },
        {
          "name": "domain_knowledge",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Expertise in the specific industry or vertical being discussed",
          "hidden": false
        },
        {
          "name": "invested",
          "type": "bool",
          "default": false,
          "description": "Whether this participant has committed capital in this round",
          "hidden": false
        },
        {
          "name": "passed",
          "type": "bool",
          "default": false,
          "description": "Whether this participant has formally passed on the opportunity",
          "hidden": false
        },
        {
          "name": "commitments",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": 1000.0,
          "description": "Number of investors who have committed to this participant's round",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "capital",
      "conservation": true,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Investment capital that flows between participants"
    }
  ],
  "relation_types": [
    {
      "name": "interest",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How interested one participant is in working with or investing in another"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Participant"
      ],
      "visible_properties": {
        "Participant": [
          "capital",
          "technical_expertise",
          "business_acumen",
          "charisma",
          "risk_appetite",
          "domain_knowledge",
          "invested",
          "passed",
          "commitments"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "capital"
      ]
    }
  ],
  "actions": [
    {
      "name": "pitch_startup",
      "description": "Deliver a startup pitch, presenting the vision, product, market opportunity, and ask",
      "actor_type": "Participant",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "charisma",
        "difficulty": 0.5
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "charisma",
          "value": 0.02,
          "description": "Successful pitch builds confidence and presence"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "charisma",
          "value": -0.02,
          "description": "Fumbled pitch shakes confidence"
        }
      ]
    },
    {
      "name": "ask_question",
      "description": "Ask a probing question to test the founder's knowledge and preparedness",
      "actor_type": "Participant",
      "target_type": "Participant",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "business_acumen",
        "defender_skill": "technical_expertise"
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "target",
          "operation": "add",
          "field": "charisma",
          "value": -0.03,
          "description": "Tough question exposes weakness"
        }
      ],
      "effects_on_failure": [
        {
          "target": "target",
          "operation": "add",
          "field": "charisma",
          "value": 0.02,
          "description": "Strong answer to tough question impresses"
        }
      ]
    },
    {
      "name": "offer_term_sheet",

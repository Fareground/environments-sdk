{
  "name": "Multi-Party Negotiation",
  "description": "Multi-party negotiation and deal-making simulation. Negotiators with different styles — hard bargainers, collaborators, dealmakers, and aggressive closers — make offers, counter-offer, bluff, build rapport, and seek creative solutions to reach a deal before time runs out.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "negotiation",
        "description": "Parties exchange offers, counter-offers, build rapport, and negotiate toward a deal",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "Negotiator",
      "role": "agent",
      "description": "A negotiation participant with a distinct style, hidden reservation price, and strategic toolkit for reaching favorable deals",
      "properties": [
        {
          "name": "leverage",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Bargaining power derived from alternatives, information, or position",
          "hidden": false
        },
        {
          "name": "emotional_intelligence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to read emotions, manage relationships, and navigate interpersonal dynamics",
          "hidden": false
        },
        {
          "name": "patience",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness to wait for a better deal rather than rushing to close",
          "hidden": false
        },
        {
          "name": "reservation_price",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Hidden walk-away point — the worst deal this party will accept",
          "hidden": true
        },
        {
          "name": "transparency",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How openly this negotiator shares information and true intentions",
          "hidden": false
        },
        {
          "name": "creativity",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to find novel solutions that expand the pie for all parties",
          "hidden": false
        },
        {
          "name": "deal_reached",
          "type": "bool",
          "default": false,
          "description": "Whether this party has closed a deal",
          "hidden": false
        },
        {
          "name": "walked_away",
          "type": "bool",
          "default": false,
          "description": "Whether this party has left the negotiation for good",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "deal_value",
      "conservation": false,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Abstract value representing the total worth of the deal on the table"
    }
  ],
  "relation_types": [
    {
      "name": "trust",
      "symmetric": true,
      "default_value": 0.5,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Mutual trust between negotiating parties"
    },
    {
      "name": "leverage_over",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Asymmetric power advantage one party holds over another"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Negotiator"
      ],
      "visible_properties": {
        "Negotiator": [
          "leverage",
          "emotional_intelligence",
          "patience",
          "transparency",
          "creativity",
          "deal_reached",
          "walked_away"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "deal_value"
      ]
    }
  ],
  "actions": [
    {
      "name": "make_offer",
      "description": "Put a formal offer on the table with specific terms and conditions",
      "actor_type": "Negotiator",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "leverage",
        "difficulty": 0.4
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "leverage",
          "value": 0.02,
          "description": "Strong offer strengthens bargaining position"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "leverage",
          "value": -0.02,
          "description": "Weak offer signals desperation"
        }
      ]
    },
    {
      "name": "counter_offer",
      "description": "Respond to an offer with modified terms, pushing for better conditions",
      "actor_type": "Negotiator",
      "target_type": "Negotiator",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "leverage",
        "defender_skill": "leverage"
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "leverage",
          "value": 0.03,
          "description": "Winning counter-offer shifts power balance"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "patience",
          "value": -0.03,
          "description": "Rejected counter-offer tests patience"
        }
      ]
    },
    {
      "name": "concede",
      "description": "Make a concession on a specific point to move the negotiation forward",
      "actor_type": "Negotiator",
      "target_type": "Negotiator",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "leverage",
          "value": -0.03,
          "description": "Conceding weakens bargaining position"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "bluff",
      "description": "Misrepresent your position, alternatives, or walk-away point to gain advantage",
      "actor_type": "Negotiator",
      "target_type": "Negotiator",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_skill": "emotional_intelligence",
        "defender_skill": "emotional_intelligence"
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "leverage",
          "value": 0.05,
          "description": "Successful bluff creates perceived advantage"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "transparency",
          "value": -0.05,
          "description": "Caught bluffing destroys credibility"
        }
      ]
    },
    {
      "name": "build_rapport",
      "description": "Invest time in building a personal connection and mutual understanding",
      "actor_type": "Negotiator",
      "target_type": "Negotiator",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "emotional_intelligence",
        "difficulty": 0.3
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "emotional_intelligence",
          "value": 0.02,
          "description": "Successful rapport-building reinforces social skills"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "walk_away",
      "description": "Leave the negotiation table for good — this ends your participation without a deal",
      "actor_type": "Negotiator",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "deal_reached",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "walked_away",
          "value": true,
          "description": "This party has left the table"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "walked_away",
          "description": "A party walked away from the negotiation without a deal"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "propose_creative_solution",
      "description": "Suggest an unconventional arrangement that creates value for multiple parties",
      "actor_type": "Negotiator",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "creativity",
        "difficulty": 0.5
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "creativity",
          "value": 0.03,
          "description": "Creative solutions build reputation as innovative dealmaker"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "creativity",
          "value": -0.01,
          "description": "Rejected creative proposal is a minor setback"
        }
      ]
    },
    {
      "name": "accept_deal",
      "description": "Accept the current terms and close the deal with the target party",
      "actor_type": "Negotiator",
      "target_type": "Negotiator",
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "walked_away",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "deal_reached",
          "value": true,
          "description": "Deal closed for the accepting party"
        },
        {
          "target": "target",
          "operation": "set",
          "field": "deal_reached",
          "value": true,
          "description": "Deal closed for the counterparty"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "deal_reached",
          "description": "A deal was reached on the current terms"
        }
      ],
      "effects_on_failure": []
    }
  ],

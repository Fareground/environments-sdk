{
  "name": "Auction",
  "description": "Bidders compete to acquire an item under one of several auction formats (English, Dutch, sealed-bid first or second price, reverse). Bidders have private valuations, budget constraints, and varying risk appetites. Watch winner's curse, bid shading, jump bidding, and strategic late-bidding emerge.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "bidding",
        "description": "Bidders place bids according to the active auction format",
        "active_roles": [
          "Bidder"
        ]
      },
      {
        "name": "settlement",
        "description": "Auctioneer evaluates the bids and announces the winner",
        "active_roles": [
          "Auctioneer"
        ]
      }
    ]
  },
  "entity_types": [
    {
      "name": "Bidder",
      "role": "agent",
      "description": "A participant bidding for the auctioned item with a private valuation and budget",
      "properties": [
        {
          "name": "private_valuation",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Bidder's true value for the item (hidden from others)",
          "hidden": true
        },
        {
          "name": "budget",
          "type": "float",
          "default": 1.0,
          "min_value": 0.0,
          "max_value": null,
          "description": "Maximum amount this bidder can spend",
          "hidden": false
        },
        {
          "name": "risk_appetite",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness to bid aggressively close to or above valuation",
          "hidden": false
        },
        {
          "name": "patience",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Tendency to wait and snipe vs. bid early",
          "hidden": false
        },
        {
          "name": "information_quality",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "How well-informed about the item's true (common) value",
          "hidden": false
        },
        {
          "name": "current_high_bid",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": null,
          "description": "Highest bid this agent has placed so far",
          "hidden": false
        },
        {
          "name": "still_in",
          "type": "bool",
          "default": true,
          "description": "Whether this bidder is still active in the auction",
          "hidden": false
        }
      ]
    },
    {
      "name": "Auctioneer",
      "role": "agent",
      "description": "Runs the auction — announces the current ask price, validates bids, declares the winner",
      "properties": [
        {
          "name": "reserve_price",
          "type": "float",
          "default": 0.1,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Minimum acceptable winning bid",
          "hidden": true
        },
        {
          "name": "current_ask",
          "type": "float",
          "default": 0.0,
          "min_value": 0.0,
          "max_value": null,
          "description": "Currently announced ask price (for English/Dutch)",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "money",
      "conservation": true,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Currency bidders use to pay for the item"
    }
  ],
  "relation_types": [
    {
      "name": "rivalry",
      "symmetric": true,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "Competitive tension between specific bidders"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "Bidder",
        "Auctioneer"
      ],
      "visible_properties": {
        "Bidder": [
          "budget",
          "risk_appetite",
          "patience",
          "information_quality",
          "current_high_bid",
          "still_in"
        ],
        "Auctioneer": [
          "current_ask"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "money"
      ]
    }
  ],
  "actions": [
    {
      "name": "place_bid",
      "description": "Submit a bid at the current ask price or higher (English) / at any sealed price (sealed-bid)",
      "actor_type": "Bidder",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "still_in",
          "value": true
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "message_action": false,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "current_high_bid",
          "value": 0.05,
          "description": "Bidder commits to a higher bid"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "pass_bid",
      "description": "Decline to raise — pass on bidding higher this round (English auction)",
      "actor_type": "Bidder",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "still_in",
          "value": true
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "still_in",
          "value": false,
          "description": "Bidder drops out of the bidding"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "jump_bid",
      "description": "Bid well above the current ask price to scare off competitors (strategic move)",
      "actor_type": "Bidder",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "still_in",
          "value": true
        }
      ],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "risk_appetite",
        "difficulty": 0.4
      },
      "message_action": false,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "current_high_bid",
          "value": 0.15,
          "description": "Aggressive jump may discourage rivals"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "current_high_bid",
          "value": 0.15,
          "description": "Jump bid placed but didn't shake off competitors"
        }
      ]
    },
    {
      "name": "snipe_bid",
      "description": "Wait until the final moment, then place a last-second bid (only effective with patience)",
      "actor_type": "Bidder",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "still_in",
          "value": true
        }
      ],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill": "patience",
        "difficulty": 0.5
      },
      "message_action": false,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "current_high_bid",
          "value": 0.08,
          "description": "Successful snipe locks in win at low premium"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "withdraw",
      "description": "Permanently leave the auction (concede)",
      "actor_type": "Bidder",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "still_in",
          "value": true
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "still_in",
          "value": false,
          "description": "Bidder exits the auction"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "announce_price",
      "description": "Auctioneer announces a new ask price (English: increases; Dutch: decreases)",
      "actor_type": "Auctioneer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "message_action": false,
      "effects_on_success": [],
      "effects_on_failure": []
    },
    {
      "name": "declare_winner",
      "description": "Auctioneer announces the winning bidder and price (settlement phase)",
      "actor_type": "Auctioneer",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "message_action": false,
      "effects_on_success": [],
      "effects_on_failure": []
    }
  ],

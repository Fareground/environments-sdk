{
  "name": "Economic Policy",
  "description": "Macroeconomic policy simulation where a central bank, firms, and consumers interact through monetary policy, investment, and consumption decisions. Agents respond to inflation, employment conditions, and economic guidance to produce emergent macroeconomic dynamics.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "policy_cycle",
        "description": "Actors set rates, invest, consume, hire, and respond to economic conditions",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "EconomicActor",
      "role": "agent",
      "description": "A participant in the macroeconomy who makes decisions about spending, investment, hiring, and policy based on economic conditions and expectations",
      "properties": [
        {
          "name": "wealth",
          "type": "float",
          "default": 1000.0,
          "min_value": 0.0,
          "max_value": 1000000.0,
          "description": "Total financial resources available",
          "hidden": false
        },
        {
          "name": "influence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to shape policy and market sentiment",
          "hidden": false
        },
        {
          "name": "risk_exposure",
          "type": "float",
          "default": 0.3,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Vulnerability to economic downturns and market shocks",
          "hidden": true
        },
        {
          "name": "inflation_expectation",
          "type": "float",
          "default": 0.03,
          "min_value": 0.0,
          "max_value": 0.2,
          "description": "Expected future inflation rate",
          "hidden": true
        },
        {
          "name": "employment_rate",
          "type": "float",
          "default": 0.95,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Proportion of workforce currently employed",
          "hidden": false
        },
        {
          "name": "confidence",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Economic optimism driving spending and investment decisions",
          "hidden": true
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "capital",
      "conservation": false,
      "discrete": false,
      "min_value": 0.0,
      "max_value": null,
      "description": "Financial capital available for investment and operations"
    }
  ],
  "relation_types": [
    {
      "name": "economic_dependency",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How much one actor's economic health depends on another"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "EconomicActor"
      ],
      "visible_properties": {
        "EconomicActor": [
          "wealth",
          "influence",
          "employment_rate"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "capital"
      ]
    }
  ],
  "actions": [
    {
      "name": "set_interest_rate",
      "description": "Adjust the benchmark interest rate to influence borrowing costs and economic activity",
      "actor_type": "EconomicActor",
      "target_type": null,
      "parameters": [
        {
          "name": "rate_change",
          "type": "float",
          "default": 0.0,
          "min_value": -0.02,
          "max_value": 0.02,
          "description": "Change in interest rate (positive = tighten, negative = ease)"
        }
      ],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "influence",
        "difficulty": 0.3
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "influence",
          "value": 0.02,
          "description": "Successful rate-setting reinforces credibility"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "influence",
          "value": -0.03,
          "description": "Failed rate-setting erodes authority"
        }
      ]
    },
    {
      "name": "invest",
      "description": "Deploy capital into productive assets, expecting future returns",
      "actor_type": "EconomicActor",
      "target_type": null,
      "parameters": [
        {
          "name": "amount",
          "type": "float",
          "default": 100.0,
          "min_value": 10.0,
          "max_value": 100000.0,
          "description": "Amount of capital to invest"
        }
      ],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "gte",
          "field": "wealth",
          "value": 10,
          "description": "Must have capital to invest"
        }
      ],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "confidence",
        "difficulty": 0.4
      },
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "confidence",
          "value": 0.03,
          "description": "Successful investment boosts confidence"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "risk_exposure",
          "value": 0.05,
          "description": "Investment increases exposure"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "confidence",
          "value": -0.05,
          "description": "Failed investment damages confidence"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "risk_exposure",
          "value": 0.03,
          "description": "Even failed investments carry some exposure"
        }
      ]
    },
    {

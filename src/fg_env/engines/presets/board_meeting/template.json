{
  "name": "Board Meeting",
  "description": "Corporate board meeting simulation where executives debate strategic direction, challenge proposals, and vote on key decisions. Board dynamics emerge from individual power, expertise, and alignment as members propose, deliberate, and reach consensus or deadlock.",
  "scenario_type": "economic",
  "spatial": {
    "type": "none"
  },
  "temporal": {
    "phases": [
      {
        "name": "deliberation",
        "description": "Board members propose strategies, present data, challenge each other, and vote on motions",
        "active_roles": []
      }
    ]
  },
  "entity_types": [
    {
      "name": "BoardMember",
      "role": "agent",
      "description": "A corporate board member who participates in strategic deliberation through proposals, challenges, data presentations, and voting",
      "properties": [
        {
          "name": "seniority",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Years of experience and standing on the board",
          "hidden": false
        },
        {
          "name": "financial_acumen",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to analyze financial data and assess business viability",
          "hidden": false
        },
        {
          "name": "risk_tolerance",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Willingness to support bold or uncertain strategic moves",
          "hidden": true
        },
        {
          "name": "industry_expertise",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Deep knowledge of the industry and competitive landscape",
          "hidden": false
        },
        {
          "name": "persuasion",
          "type": "float",
          "default": 0.5,
          "min_value": 0.0,
          "max_value": 1.0,
          "description": "Ability to convince others and build coalitions",
          "hidden": true
        },
        {
          "name": "stake_ownership",
          "type": "float",
          "default": 0.05,
          "min_value": 0.0,
          "max_value": 0.3,
          "description": "Percentage of company equity owned by this board member",
          "hidden": false
        },
        {
          "name": "has_voted",
          "type": "bool",
          "default": false,
          "description": "Whether this member has already cast their vote on the current motion",
          "hidden": false
        },
        {
          "name": "motion_support",
          "type": "float",
          "default": 0.0,
          "min_value": -100.0,
          "max_value": 100.0,
          "description": "Running vote tally for the current motion (approve +1, reject -1), accumulated on the board chair",
          "hidden": false
        }
      ]
    }
  ],
  "resource_types": [
    {
      "name": "voting_power",
      "conservation": false,
      "discrete": true,
      "min_value": 0,
      "max_value": null,
      "description": "Votes available for board decisions"
    }
  ],
  "relation_types": [
    {
      "name": "alignment",
      "symmetric": true,
      "default_value": 0.5,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How closely two board members' strategic visions align"
    },
    {
      "name": "deference",
      "symmetric": false,
      "default_value": 0.0,
      "min_value": 0.0,
      "max_value": 1.0,
      "description": "How much one board member yields to another's judgment"
    }
  ],
  "visibility_rules": [
    {
      "observer_type": "*",
      "visible_entity_types": [
        "BoardMember"
      ],
      "visible_properties": {
        "BoardMember": [
          "seniority",
          "financial_acumen",
          "industry_expertise",
          "stake_ownership",
          "has_voted",
          "motion_support"
        ]
      },
      "max_range": null,
      "requires_same_location": false,
      "see_relations_involving_self": true,
      "see_all_relations": false,
      "visible_resources": [
        "voting_power"
      ]
    }
  ],
  "actions": [
    {
      "name": "propose_strategy",
      "description": "Put forward a strategic proposal for the board to consider and debate",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "industry_expertise",
        "difficulty": 0.4
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": 0.03,
          "description": "A well-received proposal builds persuasive authority"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "seniority",
          "value": 0.01,
          "description": "Successful proposals enhance standing"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": -0.02,
          "description": "A poorly received proposal weakens credibility"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "seniority",
          "value": -0.01,
          "description": "Failed proposals slightly diminish standing"
        }
      ]
    },
    {
      "name": "challenge_proposal",
      "description": "Directly challenge another board member's proposal with financial or strategic counterarguments",
      "actor_type": "BoardMember",
      "target_type": "BoardMember",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "contest",
      "resolution_params": {
        "attacker_field": "financial_acumen",
        "defender_field": "financial_acumen"
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": 0.03,
          "description": "Winning a challenge demonstrates analytical strength"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "persuasion",
          "value": -0.02,
          "description": "Having a proposal successfully challenged weakens influence"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": -0.02,
          "description": "Failed challenge makes challenger appear uninformed"
        },
        {
          "target": "target",
          "operation": "add",
          "field": "persuasion",
          "value": 0.01,
          "description": "Surviving a challenge strengthens the proposal"
        }
      ]
    },
    {
      "name": "second_motion",
      "description": "Formally support another board member's proposal to move it toward a vote",
      "actor_type": "BoardMember",
      "target_type": "BoardMember",
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "target",
          "operation": "add",
          "field": "persuasion",
          "value": 0.02,
          "description": "Being seconded strengthens the proposer's position"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "vote_approve",
      "description": "Cast a vote in favor of the current proposal (one vote per member)",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "has_voted",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "has_voted",
          "value": true,
          "description": "Vote is cast and final"
        },
        {
          "target": "board_chair_01",
          "operation": "add",
          "field": "motion_support",
          "value": 1,
          "description": "Approval vote recorded on the chair's tally"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "vote_approve_cast",
          "description": "A board member voted to approve the motion"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "vote_reject",
      "description": "Cast a vote against the current proposal (one vote per member)",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "has_voted",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "has_voted",
          "value": true,
          "description": "Vote is cast and final"
        },
        {
          "target": "board_chair_01",
          "operation": "add",
          "field": "motion_support",
          "value": -1,
          "description": "Rejection vote recorded on the chair's tally"
        },
        {
          "target": "actor",
          "operation": "emit_event",
          "value": "vote_reject_cast",
          "description": "A board member voted to reject the motion"
        }
      ],
      "effects_on_failure": []
    },
    {
      "name": "table_discussion",
      "description": "Move to postpone the current topic for further analysis or a future meeting",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [],
      "effects_on_failure": []
    },
    {
      "name": "present_data",
      "description": "Share financial analysis, market research, or performance metrics to inform the discussion",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [],
      "resolution_archetype": "skill_check",
      "resolution_params": {
        "skill_field": "financial_acumen",
        "difficulty": 0.3
      },
      "message_action": true,
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": 0.02,
          "description": "Compelling data presentation builds authority"
        },
        {
          "target": "actor",
          "operation": "add",
          "field": "financial_acumen",
          "value": 0.01,
          "description": "Preparing presentations sharpens analytical skills"
        }
      ],
      "effects_on_failure": [
        {
          "target": "actor",
          "operation": "add",
          "field": "persuasion",
          "value": -0.01,
          "description": "Weak data presentation undermines credibility"
        }
      ]
    },
    {
      "name": "abstain",
      "description": "Decline to vote on the current matter, citing conflict of interest or insufficient information",
      "actor_type": "BoardMember",
      "target_type": null,
      "parameters": [],
      "preconditions": [
        {
          "subject": "actor",
          "operator": "eq",
          "field": "has_voted",
          "value": false
        }
      ],
      "resolution_archetype": "deterministic",
      "resolution_params": {},
      "effects_on_success": [
        {
          "target": "actor",
          "operation": "set",
          "field": "has_voted",
          "value": true,
          "description": "Abstention recorded; no further vote on this motion"
        }
      ],
      "effects_on_failure": []
    }
  ],

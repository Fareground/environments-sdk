      "props": {
        "sc_count": {
          "type": "int",
          "default": 2,
          "description": "Supply centers owned (counted after each Fall)."
        },
        "delta": {
          "type": "int",
          "default": 0,
          "description": "Armies to build (positive) or disband (negative) this winter."
        },
        "out": {
          "type": "bool",
          "default": false,
          "description": "Eliminated: no centers and no armies."
        },
        "betrayals": {
          "type": "int",
          "default": 0,
          "private": true
        }
      }
    },
    "province": {
      "description": "A region of the map.",
      "props": {
        "sc": {
          "type": "bool",
          "default": false
        },
        "home": {
          "type": "text",
          "default": ""
        },
        "owner": {
          "type": "text",
          "default": ""
        },
        "standoff": {
          "type": "bool",
          "default": false
        }
      }
    },
    "army": {
      "description": "One army of a nation.",
      "props": {
        "owner": {
          "type": "text",
          "default": ""
        },
        "order": {
          "type": "enum",
          "values": [
            "hold",
            "move",
            "support"
          ],
          "default": "hold",
          "private": true
        },
        "dest": {
          "type": "text",
          "default": "",
          "private": true
        },
        "support_of": {
          "type": "text",
          "default": "",
          "private": true
        },
        "strength": {
          "type": "int",
          "default": 1,
          "private": true
        },
        "move_ok": {
          "type": "bool",
          "default": false,
          "private": true
        },
        "support_note": {
          "type": "text",
          "default": "",
          "private": true
        },
        "dislodged": {
          "type": "bool",
          "default": false
        },
        "attacker_from": {
          "type": "text",
          "default": ""
        },
        "retreat_to": {
          "type": "text",
          "default": "",
          "private": true
        },
        "retreat_ok": {
          "type": "bool",
          "default": false,
          "private": true
        }
      }
    }

          "scale": 9.135405849167979,
          "scale_se": 0.8318313349053233
        }
      ],
      "description": "Pattern 'demand', one row per key: scale fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    }
  },
  "types": {
    "sku": {
      "description": "A stocked part in one tier.",
      "props": {
        "part": "",
        "category": "",
        "tier": {
          "type": "enum",
          "values": [
            "premium",
            "value"
          ],
          "default": "value"
        },
        "sibling": "",
        "list_price": 0.0,
        "unit_cost": 0.0,
        "lead_weeks": 1,
        "case_pack": 1,
        "stock": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "pipeline": {
          "type": "list",
          "default": []
        },
        "price": 0.0,
        "promo": 0.0,
        "demand": 0,
        "spill_in": 0,
        "sold": 0,
        "lost": 0,
        "recent": {
          "type": "list",
          "default": []
        },
        "units_total": 0,
        "demand_total": 0,
        "lost_total": 0,
        "revenue": 0.0,
        "cogs": 0.0,
        "holding": 0.0,
        "orders": 0,
        "weeks_out": 0
      }
    }
  },
  "population": [
    {
      "type": "sku",
      "from": "$inputs.skus",
      "id": "{$row.sku}",
      "name": "{$row.sku}",
      "props": {
        "part": "$row.part",
        "category": "$row.category",
        "tier": "$row.tier",
        "sibling": "$row.sibling",
        "list_price": "$row.list_price",
        "unit_cost": "$row.unit_cost",
        "lead_weeks": "$row.lead_weeks",
        "case_pack": "$row.case_pack",
        "price": "$row.list_price",
        "stock": "$ceil($pattern.demand($row.sku) * 4)"
      }
    }
  ],
  "records": {
    "history": {
      "fields": {
        "week_start": "text",
        "sku": "text",
        "units": "int",
        "stockout": "int",
        "price": "number",
        "rel_price": "number",
        "promo": "number"
      },
      "notify": false,
      "description": "Every SKU-week, when record_history is on."
    }
  },
  "patterns": {
    "growth": {
      "kind": "trend",
      "form": "exponential",
      "rate": "$inputs.growth_rate",
      "origin": "2026-01-05",
      "uncertainty": {
        "rate": "$inputs.growth_rate_se * $inputs.parameter_uncertainty"
      },
      "description": "Demand growth as the local fleet ages."
    },
    "season": {
      "kind": "seasonal",
      "period": "year",
      "table": "$inputs.season_fit",
      "column": "category",
      "profile": "$row.profile",
      "uncertainty": {
        "profile": "$map($row.profile_se, $it * $inputs.parameter_uncertainty)"
      },
      "description": "Each category's month-by-month demand index."
    },
    "demand": {
      "kind": "product",
      "table": "$inputs.demand_fit",
      "column": "sku",
      "scale": "$row.scale",
      "of": [
        "growth",
        {
          "pattern": "season",
          "key": "$row.category"
        }
      ],
      "uncertainty": {
        "scale": "$row.scale_se * $inputs.parameter_uncertainty"
      },
      "description": "Expected weekly demand of a SKU at list price, before promotions and substitution.",
      "fit": {
        "data": "$inputs.history",
        "value": "units",
        "time": "week_start",
        "key": "sku",
        "censored": "stockout",
        "noise": "sales",
        "x": {
          "price_effect": {
            "column": "rel_price",
            "key": "$row.category"
          },
          "promo": "promo"
        }
      }
    },
    "price_effect": {
      "kind": "elasticity",
      "table": "$inputs.price_effect_fit",
      "column": "category",
      "elasticity": "$row.elasticity",
      "reference": 1.0,
      "uncertainty": {
        "elasticity": "$row.elasticity_se * $inputs.parameter_uncertainty"
      },
      "description": "How demand answers the price relative to list price."
    },
    "promo": {
      "kind": "promotion",
      "keys": "sku",
      "input": "$it.promo",
      "form": "exponential",
      "lift": "$inputs.promo_lift",
      "dip": "$inputs.promo_dip",
      "retain": "$inputs.promo_retain",
      "uncertainty": {
        "lift": "$inputs.promo_lift_se * $inputs.parameter_uncertainty"
      },
      "description": "A promotion lifts demand while it runs; customers who bought early buy less after."
    },
    "substitution": {
      "kind": "cross_price",
      "keys": "sku",
      "reference": "$dict($inputs.skus, $it.sku, $it.list_price)",
      "own": "-$inputs.cross_elasticity",
      "cross": "$inputs.cross_elasticity",
      "groups": "$dict($inputs.skus, $it.sku, $it.part)",
      "description": "Demand moves between a part's tiers when their relative price changes."
    },
    "promo_week": {
      "kind": "shocks",
      "table": "$inputs.categories",
      "column": "category",
      "recur": "$inputs.promo_every",
      "window": [
        "$row.promo_offset",
        null
      ],
      "description": "A category's promotion weeks."
    },
    "price_index": {
      "kind": "mean_reversion",
      "table": "$inputs.categories",
      "column": "category",
      "mean": 1.0,
      "rate": 0.3,
      "sd": 0.04,
      "min": 0.8,
      "max": 1.2,
      "description": "The store's regular price level for a category, following suppliers and competitors."
    },
    "sales": {
      "kind": "counts",
      "dist": "negative_binomial",
      "dispersion": "$inputs.sales_dispersion",
      "description": "Weekly units asked for, around the expected demand."
    },
    "sold": {
      "kind": "censored",
      "description": "Units sold: demand capped by stock, with what was lost."
    },
    "lead_noise": {
      "kind": "noise",
      "keys": "sku",
      "sd": 0.3,
      "description": "How far a delivery runs early or late, as a log factor."
    }
  },
  "events": [
    {
      "name": "receive_and_price",
      "phase": "start",
      "each": "sku",
      "as": "s",
      "do": [
        "$s.stock += $sum($filter($s.pipeline, $it[0] <= $round), $it[1])",
        "$s.pipeline = $filter($s.pipeline, $it[0] > $round)",
        "$s.promo = $inputs.promo_depth if $pattern.promo_week($s.category) > 0 else 0",
        "$s.price = $round($s.list_price * $pattern.price_index($s.category) * (1 - $s.promo) * (1 + $inputs.premium_markup if $s.tier == premium else 1), 2)",
        "$s.spill_in = 0"
      ]
    },
    {
      "name": "trade",
      "phase": "end",
      "each": "sku",
      "as": "s",
      "order": "0 if $s.tier == premium else 1",
      "do": [
        "$prices = $dict(sku, $it.id, $it.price)",
        "$mean = $pattern.demand($s) * $pattern.price_effect($s.price / $s.list_price, $s.category) * $pattern.promo($s) * $pattern.substitution($prices, $s)",
        "$s.demand = $pattern.sales($mean, $s)",
        "$sale = $pattern.sold($s.demand + $s.spill_in, $s.stock)",
        "$s.sold = $sale.value",
        "$s.lost = $sale.lost",
        {
          "if": "$s.tier == premium and $sale.lost > 0",
          "then": "$entity($s.sibling).spill_in += $round($sale.lost * $inputs.spill_share)"
        },
        "$s.stock -= $s.sold",
        "$s.weeks_out += 1 if $sale.censored else 0",
        "$s.units_total += $s.sold",
        "$s.demand_total += $s.demand + $s.spill_in",
        "$s.lost_total += $s.lost",
        "$s.revenue += $s.sold * $s.price",
        "$s.cogs += $s.sold * $s.unit_cost",
        "$s.recent = $slice($s.recent + [$s.sold], -8)",
        {
          "if": "$inputs.record_history",
          "then": {
            "post": "history",
            "week_start": "$clock.date",
            "sku": "$s.id",
            "units": "$s.sold",
            "stockout": "1 if $sale.censored else 0",
            "price": "$s.price",
            "rel_price": "$round($s.price / $s.list_price, 4)",
            "promo": "$s.promo"
          }
        }
      ]
    },
    {
      "name": "reorder",
      "phase": "end",
      "each": "sku",
      "as": "s",
      "do": [
        "$s.holding += $s.stock * $s.unit_cost * $inputs.holding_rate",
        "$position = $s.stock + $sum($s.pipeline, $it[1])",
        {
          "if": "$inputs.policy == service",
          "then": [
            "$forecast = $pattern.demand($s)",
            "$cover = $forecast * ($s.lead_weeks + 1)",
            "$target = $ceil($cover + $inputs.service_z * $sqrt($cover * (1 + $forecast / $inputs.sales_dispersion)))",
            "$reorder_at = $target"
          ],
          "else": [
            "$average = $avg($s.recent, $it) if $len($s.recent) > 0 else 0",
            "$reorder_at = $ceil($average * $s.lead_weeks * $inputs.lean_cover)",
            "$target = $reorder_at + $ceil($average * 1.5)"
          ]
        },
        {
          "if": "$position <= $reorder_at and $target > $position",
          "then": [
            "$qty = $max($s.case_pack, $ceil(($target - $position) / $s.case_pack) * $s.case_pack)",
            "$delay = $max(1, $round($s.lead_weeks * $exp($pattern.lead_noise($s))))",
            "$s.pipeline = $s.pipeline + [[$round + $delay, $qty]]",
            "$s.orders += 1"
          ]
        }
      ]
    }
  ],
  "metrics": {
    "sold": {
      "expr": "$sum(sku, $it.sold)",
      "unit": "units"
    },
    "lost": {
      "expr": "$sum(sku, $it.lost)",
      "unit": "units"
    },
    "stock_value": {
      "expr": "$round($sum(sku, $it.stock * $it.unit_cost), 2)",
      "unit": "USD"
    },
    "skus_out": {
      "expr": "$count(sku, $it.lost > 0)",
      "description": "SKUs that ran out this week"
    }
  },
  "outputs": {
    "fill_rate": {
      "expr": "$round($sum(sku, $it.units_total) / $max(1, $sum(sku, $it.demand_total)), 4)",
      "type": "number",
      "description": "Share of demand served from stock"
    },
    "lost_units": {
      "expr": "$sum(sku, $it.lost_total)",
      "type": "int"
    },
    "revenue": {
      "expr": "$round($sum(sku, $it.revenue), 2)",
      "type": "number"
    },
    "holding_cost": {
      "expr": "$round($sum(sku, $it.holding), 2)",
      "type": "number"
    },
    "order_costs": {
      "expr": "$sum(sku, $it.orders) * $inputs.order_cost",
      "type": "number"
    },
    "profit": {
      "expr": "$round($sum(sku, $it.revenue - $it.cogs - $it.holding) - $sum(sku, $it.orders) * $inputs.order_cost, 2)",
      "type": "number",
      "description": "Gross margin less holding and ordering costs"
    },

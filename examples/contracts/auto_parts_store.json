  "types": {
    "sku": {
      "description": "A stocked part in one tier.",
      "props": {
        "part": "",
        "category": "",
        "tier": {
          "type": "enum",
          "values": [
            "premium",
            "value"
          ],
          "default": "value"
        },
        "sibling": "",
        "list_price": 0.0,
        "unit_cost": 0.0,
        "lead_weeks": 1,
        "case_pack": 1
      }
    }
  },
  "population": [
    {
      "type": "sku",
      "from": "$inputs.skus",
      "id": "{$row.sku}",
      "name": "{$row.sku}",
      "props": {
        "part": "$row.part",
        "category": "$row.category",
        "tier": "$row.tier",
        "sibling": "$row.sibling",
        "list_price": "$row.list_price",
        "unit_cost": "$row.unit_cost",
        "lead_weeks": "$row.lead_weeks",
        "case_pack": "$row.case_pack",
        "stock": "$get($inputs.opening_stock, $row.sku, $ceil($pattern.demand($row.sku) * 4))",
        "reorder_pipeline": "$get($inputs.opening_orders, $row.sku, [])",
        "reorder_on_order": "$sum($get($inputs.opening_orders, $row.sku, []), $it[1])"
      }
    }
  ],
  "patterns": {
    "growth": {
      "kind": "trend",
      "form": "exponential",
      "rate": "$inputs.growth_rate",
      "origin": "2026-01-05",
      "uncertainty": {
        "rate": "$inputs.growth_rate_se * $inputs.parameter_uncertainty"
      },
      "description": "Demand growth as the local fleet ages."
    },
    "season": {
      "kind": "seasonal",
      "period": "year",
      "table": "$inputs.season_fit",
      "column": "category",
      "profile": "$row.profile",
      "uncertainty": {
        "profile": "$map($row.profile_se, $it * $inputs.parameter_uncertainty)"
      },
      "description": "Each category's month-by-month demand index."
    },
    "demand": {
      "kind": "product",
      "table": "$inputs.demand_fit",
      "column": "sku",
      "scale": "$row.scale",
      "of": [
        "growth",
        {
          "pattern": "season",
          "key": "$row.category"
        }
      ],
      "uncertainty": {
        "scale": "$row.scale_se * $inputs.parameter_uncertainty"
      },
      "description": "Expected weekly demand of a SKU at list price, before promotions and substitution.",
      "fit": {
        "data": "$inputs.history",
        "value": "units",
        "time": "time",
        "key": "item",
        "censored": "stockout",
        "noise": "sales",
        "x": {
          "price_effect": {
            "column": "price_effect",
            "key": "$row.category"
          },
          "promo": "promo"
        }
      }
    },
    "price_effect": {
      "kind": "elasticity",
      "table": "$inputs.price_effect_fit",
      "column": "category",
      "elasticity": "$row.elasticity",
      "reference": 1.0,
      "uncertainty": {
        "elasticity": "$row.elasticity_se * $inputs.parameter_uncertainty"
      },
      "description": "How demand answers the price relative to list price."
    },
    "promo": {
      "kind": "promotion",
      "keys": "sku",
      "input": "$it.shop_promo",
      "form": "exponential",
      "lift": "$inputs.promo_lift",
      "dip": "$inputs.promo_dip",
      "retain": "$inputs.promo_retain",
      "uncertainty": {
        "lift": "$inputs.promo_lift_se * $inputs.parameter_uncertainty"
      },
      "description": "A promotion lifts demand while it runs; customers who bought early buy less after."
    },
    "substitution": {
      "kind": "cross_price",
      "keys": "sku",
      "reference": "$dict($inputs.skus, $it.sku, $it.list_price)",
      "own": "-$inputs.cross_elasticity",
      "cross": "$inputs.cross_elasticity",
      "groups": "$dict($inputs.skus, $it.sku, $it.part)",
      "description": "Demand moves between a part's tiers when their relative price changes."
    },
    "promo_week": {
      "kind": "shocks",
      "table": "$inputs.categories",
      "column": "category",
      "recur": "$inputs.promo_every",
      "window": [
        "$row.promo_offset",
        null
      ],
      "description": "A category's promotion weeks."
    },
    "price_index": {
      "kind": "mean_reversion",
      "table": "$inputs.categories",
      "column": "category",
      "mean": 1.0,
      "rate": 0.3,
      "sd": 0.04,
      "min": 0.8,
      "max": 1.2,
      "description": "The store's regular price level for a category, following suppliers and competitors."
    },
    "sales": {
      "kind": "counts",
      "dist": "negative_binomial",
      "dispersion": "$inputs.sales_dispersion",
      "description": "Weekly units asked for, around the expected demand."
    },
    "lead_noise": {
      "kind": "noise",
      "dist": "lognormal",
      "mean": "$inputs.lead_noise_mean",
      "sd": "$inputs.lead_noise_sd",
      "description": "How far a delivery runs early or late: a factor on the SKU's lead time.",
      "fit": {
        "data": "$inputs.orders",
        "value": "factor"
      },
      "uncertainty": {
        "mean": "$inputs.lead_noise_mean_se * $inputs.parameter_uncertainty"
      }
    }
  },
  "mechanisms": {
    "shop": {
      "kind": "economy",
      "mode": "demand",
      "items": "sku",
      "stock": "stock",
      "promotion": "$inputs.promo_depth if $pattern.promo_week($it.category) > 0 else 0",
      "price": "$round($it.list_price * $pattern.price_index($it.category) * (1 - $it.shop_promo) * (1 + $inputs.premium_markup if $it.tier == premium else 1), 2)",
      "cost": "$it.unit_cost",
      "group": "$it.category",
      "rate": "demand",
      "factors": [
        {
          "pattern": "price_effect",
          "key": "$it.category",
          "driver": "$price / $it.list_price"
        },
        "promo",
        "substitution"
      ],
      "noise": "sales",
      "substitutes": "[$it.sibling] if $it.tier == premium else []",
      "spill": "$inputs.spill_share",
      "record": "$inputs.record_history"
    },
    "reorder": {
      "kind": "economy",
      "mode": "replenishment",
      "demand": "shop",
      "policy": "'s_S' if $inputs.policy == lean else 'service'",
      "reorder_point": "$ceil($recent * $it.lead_weeks * $inputs.lean_cover)",
      "order_up_to": "$ceil($recent * $it.lead_weeks * $inputs.lean_cover) + $ceil($recent * 1.5)",
      "service_level": "$get($inputs.service_level_by_category, $it.category, $inputs.service_level)",
      "lead_time": {
        "pattern": "lead_noise",
        "scale": "$it.lead_weeks"
      },
      "case_pack": "$it.case_pack",
      "holding_cost": "$it.unit_cost * $inputs.holding_rate",
      "order_cost": "$inputs.order_cost",
      "record": "$inputs.record_history"
    }
  },
  "arms": {
    "lean": {
      "description": "The store's current rule.",
      "inputs": {
        "policy": "lean"
      }
    },
    "service": {
      "description": "Order up to the expected demand over lead time and review, with safety stock for a 95% service level.",
      "inputs": {
        "policy": "service"
      }
    },
    "premium_price_up": {
      "description": "Premium tiers 10% dearer: substitution moves demand to the value tier.",
      "inputs": {
        "premium_markup": 0.1
      }
    },

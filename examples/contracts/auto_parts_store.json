{
  "fg_env": "1",
  "name": "Auto parts store: demand patterns and reorder policies",
  "description": "A parts store's weekly trade in 12 SKUs (brake pads, batteries and wiper blades for two makes, each in a premium and a value tier). Demand per SKU is a fitted base × a trend × a per-category season × a price response (to regular price moves and promotions) × a promotion with a dip after it × substitution between the tiers, drawn as negative-binomial counts; sales are capped by stock (a stockout loses demand, part of which spills to the other tier), and orders arrive after a noisy lead time. The demand patterns are fitted from auto_parts_store/history.csv (fg_env.fit_patterns; examples/auto_parts_history.py regenerates the history from the `truth` arm and refits). Arms compare the store's lean reorder rule with an order-up-to rule driven by the fitted forecast.",
  "brief": {
    "situation": "A car-parts store deciding how to keep its shelves stocked."
  },
  "clock": {
    "rounds": 52,
    "unit": "week",
    "start": "2026-01-05"
  },
  "inputs": {
    "skus": {
      "type": "table",
      "source": "auto_parts_store/skus.csv",
      "columns": {
        "list_price": "number",
        "unit_cost": "number",
        "lead_weeks": "int",
        "case_pack": "int"
      },
      "description": "The SKUs: part, category, tier, sibling in the other tier, prices, cost, lead time and case pack."
    },
    "history": {
      "type": "table",
      "source": "auto_parts_store/history.csv",
      "columns": {
        "units": "int",
        "stockout": "int",
        "price": "number",
        "rel_price": "number",
        "promo": "number"
      },
      "description": "Weekly sales history the demand patterns are fitted from: units sold, whether stock ran out, price and promotion depth."
    },
    "categories": {
      "type": "table",
      "default": [
        {
          "category": "brake_pads",
          "promo_offset": 2
        },
        {
          "category": "batteries",
          "promo_offset": 4
        },
        {
          "category": "wipers",
          "promo_offset": 0
        }
      ],
      "description": "Each category's promotion calendar offset (weeks)."
    },
    "policy": {
      "type": "enum",
      "values": [
        "lean",
        "service"
      ],
      "default": "lean",
      "description": "lean: reorder when stock covers less than lean_cover of the lead time at the trailing 8-week average | service: order up to the fitted forecast over lead time plus a week, with a safety margin."
    },
    "service_z": {
      "type": "number",
      "default": 1.65,
      "min": 0,
      "description": "Safety margin of the service policy, in standard deviations of demand over the cover."
    },
    "lean_cover": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "description": "The lean rule reorders when stock covers less than this share of the lead time at the trailing 8-week average."
    },
    "holding_rate": {
      "type": "number",
      "default": 0.004,
      "min": 0,
      "description": "Holding cost per week, as a share of the unit cost."
    },
    "order_cost": {
      "type": "number",
      "default": 6.0,
      "min": 0,
      "description": "Cost of placing one order.",
      "unit": "USD"
    },
    "promo_every": {
      "type": "int",
      "default": 6,
      "min": 2,
      "description": "Weeks between a category's promotions."
    },
    "promo_depth": {
      "type": "number",
      "default": 0.2,
      "min": 0,
      "max": 0.9,
      "description": "Share off during a promotion."
    },
    "promo_dip": {
      "type": "number",
      "default": 0.25,
      "min": 0,
      "max": 1,
      "description": "Demand lost after a promotion per unit of remembered promotion (assumed, not fitted)."
    },
    "promo_retain": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Share of the remembered promotion kept each week."
    },
    "cross_elasticity": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "description": "How strongly demand moves between tiers when their relative price changes (assumed)."
    },
    "spill_share": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "description": "Share of a premium stockout's lost demand that buys the value tier instead."
    },
    "premium_markup": {
      "type": "number",
      "default": 0.0,
      "min": -0.5,
      "max": 1,
      "description": "Extra share on premium prices (a pricing experiment)."
    },
    "record_history": {
      "type": "bool",
      "default": false,
      "description": "Post every SKU-week to the history record (the truth arm does)."
    },
    "parameter_uncertainty": {
      "type": "number",
      "default": 1,
      "min": 0,
      "description": "Scales the standard errors of fitted pattern parameters: 1 draws each run's parameters around their estimates, 0 uses the estimates as they are."
    },
    "growth_rate": {
      "type": "number",
      "default": 0.0007844961619680142,
      "description": "Pattern 'growth', rate: fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "growth_rate_se": {
      "type": "number",
      "default": 0.00032286044610652646,
      "description": "Standard error of growth_rate."
    },
    "promo_lift": {
      "type": "number",
      "default": 1.4425211045090005,
      "description": "Pattern 'promo', lift: fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "promo_lift_se": {
      "type": "number",
      "default": 0.3537005885146852,
      "description": "Standard error of promo_lift."
    },
    "sales_dispersion": {
      "type": "number",
      "default": 5.604558369912476,
      "description": "Pattern 'sales', dispersion: fitted by fg_env.fit_patterns from $inputs.history (method of moments around the fitted means)."
    },
    "season_fit": {

    },
    "lead_noise_mean": {"type": "number", "default": 0.005867781736690959, "description": "Pattern 'lead_noise', mean: fitted by fg_env.analysis.fit_patterns from $inputs.orders (method of moments)."},
    "lead_noise_mean_se": {"type": "number", "default": 0.010755840694114713, "description": "Standard error of lead_noise_mean."},
    "lead_noise_sd": {"type": "number", "default": 0.29788047876877144, "description": "Pattern 'lead_noise', sd: fitted by fg_env.analysis.fit_patterns from $inputs.orders (method of moments)."}
  },
  "clock": {"rounds": "$inputs.weeks", "unit": "week", "start": "$inputs.start"},
  "types": {
    "sku": {
      "description": "A stocked part in one tier.",
      "props": {
        "part": "",
        "category": "",
        "tier": {"type": "enum", "values": ["premium", "value"], "default": "value"},
        "sibling": "",
        "list_price": 0.0,
        "unit_cost": 0.0,
        "lead_weeks": 1,
        "case_pack": 1
      }
    }
  },
  "entities": {
    "sku": {
      "type": "sku",
      "from": "$inputs.skus",
      "id": "{$row.sku}",
      "name": "{$row.sku}",
      "props": {"part": "$row.part", "category": "$row.category", "tier": "$row.tier", "sibling": "$row.sibling", "list_price": "$row.list_price", "unit_cost": "$row.unit_cost", "lead_weeks": "$row.lead_weeks", "case_pack": "$row.case_pack", "stock": "$get($inputs.opening_stock, $row.sku, $ceil($pattern.demand($row.sku) * 4))", "reorder_pipeline": "$get($inputs.opening_orders, $row.sku, [])", "reorder_on_order": "$sum($get($inputs.opening_orders, $row.sku, []), $it[1])"}
    }
  },
  "arms": {
    "lean": {"description": "The store's current rule.", "inputs": {"policy": "lean"}},
    "service": {
      "description": "Order up to the expected demand over lead time and review, with safety stock for a 95% service level.",
      "inputs": {"policy": "service"}
    },
    "premium_price_up": {
      "description": "Premium tiers 10% dearer: substitution moves demand to the value tier.",
      "inputs": {"premium_markup": 0.1}
    },
    "truth": {
      "description": "The world that generated history.csv: the true parameters, three years from 2023 under a less tight lean rule, recording every week.",
      "inputs": {
        "record_history": true,
        "parameter_uncertainty": 0,
        "growth_rate": 0.0006,
        "promo_lift": 1.65,
        "sales_dispersion": 5.0,
        "season_fit": [
          {

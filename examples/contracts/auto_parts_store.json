      ],
      "description": "Pattern 'season', one row per key: profile fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "price_effect_fit": {
      "type": "table",
      "default": [
        {
          "category": "brake_pads",
          "elasticity": -1.1802115926655554,
          "elasticity_se": 0.3284880276995871
        },
        {
          "category": "batteries",
          "elasticity": -0.20497941416771534,
          "elasticity_se": 0.37275865995229573
        },
        {
          "category": "wipers",
          "elasticity": -1.7633365169273634,
          "elasticity_se": 0.3187999004439313
        }
      ],
      "description": "Pattern 'price_effect', one row per key: elasticity fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "demand_fit": {
      "type": "table",
      "default": [

        ],
        "price_effect_fit": [
          {"category": "brake_pads", "elasticity": -1.1, "elasticity_se": 0.0},
          {"category": "batteries", "elasticity": -0.7, "elasticity_se": 0.0},
          {"category": "wipers", "elasticity": -1.3, "elasticity_se": 0.0}
        ],
        "demand_fit": [
          {"sku": "PAD-TOY-P", "category": "brake_pads", "scale": 6.0, "scale_se": 0.0},
          {"sku": "PAD-TOY-V", "category": "brake_pads", "scale": 11.0, "scale_se": 0.0},
          {"sku": "PAD-FOR-P", "category": "brake_pads", "scale": 4.0, "scale_se": 0.0},
          {"sku": "PAD-FOR-V", "category": "brake_pads", "scale": 8.0, "scale_se": 0.0},
          {"sku": "BAT-TOY-P", "category": "batteries", "scale": 3.0, "scale_se": 0.0},
          {"sku": "BAT-TOY-V", "category": "batteries", "scale": 5.0, "scale_se": 0.0},
          {"sku": "BAT-FOR-P", "category": "batteries", "scale": 2.5, "scale_se": 0.0},
          {"sku": "BAT-FOR-V", "category": "batteries", "scale": 4.5, "scale_se": 0.0},
          {"sku": "WIP-TOY-P", "category": "wipers", "scale": 7.0, "scale_se": 0.0},
          {"sku": "WIP-TOY-V", "category": "wipers", "scale": 12.0, "scale_se": 0.0},
          {"sku": "WIP-FOR-P", "category": "wipers", "scale": 5.0, "scale_se": 0.0},
          {"sku": "WIP-FOR-V", "category": "wipers", "scale": 9.0, "scale_se": 0.0}
        ],
        "lean_cover": 1.2,
        "start": "2023-01-02",
        "weeks": 156,
        "lead_noise_mean": 0,
        "lead_noise_sd": 0.3
      }
    }
  },
  "mechanisms": {
    "shop": {
      "kind": "economy",
      "mode": "demand",
      "items": "sku",
      "stock": "stock",
      "promotion": "$inputs.promo_depth if $pattern.promo_week($it.category) > 0 else 0",
      "price": "$round($it.list_price * $pattern.price_index($it.category) * (1 - $it.shop_promo) * (1 + $inputs.premium_markup if $it.tier == premium else 1), 2)",
      "cost": "$it.unit_cost",
      "group": "$it.category",
      "rate": "demand",
      "factors": [
        {"pattern": "price_effect", "key": "$it.category", "driver": "$price / $it.list_price"},
        "promo",
        "substitution"
      ],
      "noise": "sales",
      "substitutes": "[$it.sibling] if $it.tier == premium else []",
      "spill": "$inputs.spill_share",
      "record": "$inputs.record_history"
    },
    "reorder": {
      "kind": "economy",
      "mode": "replenishment",
      "demand": "shop",
      "policy": "'s_S' if $inputs.policy == lean else 'service'",
      "reorder_point": "$ceil($recent * $it.lead_weeks * $inputs.lean_cover)",
      "order_up_to": "$ceil($recent * $it.lead_weeks * $inputs.lean_cover) + $ceil($recent * 1.5)",
      "service_level": "$get($inputs.service_level_by_category, $it.category, $inputs.service_level)",
      "lead_time": {"pattern": "lead_noise", "scale": "$it.lead_weeks"},
      "case_pack": "$it.case_pack",
      "holding_cost": "$it.unit_cost * $inputs.holding_rate",
      "order_cost": "$inputs.order_cost",
      "record": "$inputs.record_history"
    },
    "growth": {
      "kind": "pattern",
      "mode": "trend",
      "form": "exponential",
      "rate": "$inputs.growth_rate",
      "origin": "2026-01-05",
      "uncertainty": {"rate": "$inputs.growth_rate_se * $inputs.parameter_uncertainty"},
      "description": "Demand growth as the local fleet ages."
    },
    "season": {
      "kind": "pattern",
      "mode": "seasonal",
      "period": "year",
      "table": "$inputs.season_fit",
      "column": "category",
      "profile": "$row.profile",
      "uncertainty": {"profile": "$map($row.profile_se, $it * $inputs.parameter_uncertainty)"},
      "description": "Each category's month-by-month demand index."
    },
    "demand": {
      "kind": "pattern",
      "mode": "product",
      "table": "$inputs.demand_fit",
      "column": "sku",
      "scale": "$row.scale",
      "of": ["growth", {"pattern": "season", "key": "$row.category"}],
      "uncertainty": {"scale": "$row.scale_se * $inputs.parameter_uncertainty"},
      "description": "Expected weekly demand of a SKU at list price, before promotions and substitution.",
      "fit": {
        "data": "$inputs.history",
        "value": "units",
        "time": "time",
        "key": "item",
        "censored": "stockout",
        "noise": "sales",
        "x": {"price_effect": {"column": "price_effect", "key": "$row.category"}, "promo": "promo"}
      }
    },
    "price_effect": {
      "kind": "pattern",
      "mode": "elasticity",
      "table": "$inputs.price_effect_fit",
      "column": "category",
      "elasticity": "$row.elasticity",
      "reference": 1.0,
      "uncertainty": {"elasticity": "$row.elasticity_se * $inputs.parameter_uncertainty"},
      "description": "How demand answers the price relative to list price."
    },
    "promo": {
      "kind": "pattern",
      "mode": "promotion",
      "keys": "sku",
      "input": "$it.shop_promo",
      "form": "exponential",
      "lift": "$inputs.promo_lift",
      "dip": "$inputs.promo_dip",
      "retain": "$inputs.promo_retain",
      "uncertainty": {"lift": "$inputs.promo_lift_se * $inputs.parameter_uncertainty"},
      "description": "A promotion lifts demand while it runs; customers who bought early buy less after."
    },
    "substitution": {"kind": "pattern", "mode": "cross_price", "keys": "sku", "reference": "$dict($inputs.skus, $it.sku, $it.list_price)", "own": "-$inputs.cross_elasticity", "cross": "$inputs.cross_elasticity", "groups": "$dict($inputs.skus, $it.sku, $it.part)", "description": "Demand moves between a part's tiers when their relative price changes."},
    "promo_week": {
      "kind": "pattern",
      "mode": "shocks",
      "table": "$inputs.categories",
      "column": "category",
      "recur": "$inputs.promo_every",
      "window": ["$row.promo_offset", null],
      "description": "A category's promotion weeks."
    },
    "price_index": {"kind": "pattern", "mode": "mean_reversion", "table": "$inputs.categories", "column": "category", "mean": 1.0, "rate": 0.3, "sd": 0.04, "min": 0.8, "max": 1.2, "description": "The store's regular price level for a category, following suppliers and competitors."},
    "sales": {"kind": "pattern", "mode": "counts", "dist": "negative_binomial", "dispersion": "$inputs.sales_dispersion", "description": "Weekly units asked for, around the expected demand."},
    "lead_noise": {
      "kind": "pattern",
      "mode": "noise",
      "dist": "lognormal",
      "mean": "$inputs.lead_noise_mean",
      "sd": "$inputs.lead_noise_sd",
      "description": "How far a delivery runs early or late: a factor on the SKU's lead time.",
      "fit": {"data": "$inputs.orders", "value": "factor"},
      "uncertainty": {"mean": "$inputs.lead_noise_mean_se * $inputs.parameter_uncertainty"}
    }
  }
}

      "description": "Pattern 'season', one row per key: profile fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "price_effect_fit": {
      "type": "table",
      "default": [
        {
          "category": "brake_pads",
          "elasticity": -1.183294883840624,
          "elasticity_se": 0.32866610590086937
        },
        {

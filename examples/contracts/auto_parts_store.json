{
  "fg_env": "1",
  "name": "Auto parts store: demand patterns and reorder policies",
  "description": "A parts store's weekly trade in 12 SKUs (brake pads, batteries and wiper blades for two makes, each in a premium and a value tier), on the economy demand and replenishment modes. Demand per SKU is a fitted base × a trend × a per-category season × a price response × a promotion with a dip after it × substitution between the tiers, drawn as negative-binomial counts; sales are capped by stock, part of a premium stockout buys the value tier, and orders arrive after a lead time drawn per order. The demand patterns are fitted from auto_parts_store/history.csv (fg_env.fit_patterns; examples/auto_parts_history.py regenerates the history from the `truth` arm and refits). Arms compare the store's lean reorder rule with a service-level policy; examples/auto_parts_policies.py compares them, optimises a service level per category and validates the forecast on held-out quarters.",
  "brief": {
    "situation": "A car-parts store deciding how to keep its shelves stocked."
  },
  "clock": {
    "rounds": "$inputs.weeks",
    "unit": "week",
    "start": "$inputs.start"
  },
  "inputs": {
    "start": {
      "type": "text",
      "default": "2026-01-05",
      "description": "The first week (a Monday)."
    },
    "weeks": {
      "type": "int",
      "default": 52,
      "min": 1,
      "description": "Weeks to run."
    },
    "opening_stock": {
      "type": "map",
      "default": {},
      "description": "Units on hand per SKU at the start, {sku: units}; SKUs left out start with four weeks of forecast demand."
    },
    "opening_orders": {
      "type": "map",
      "default": {},
      "description": "Orders on their way at the start, {sku: [[week due, units, week placed, lead time, lead-time factor], …]} with weeks counted from the first."
    },
    "skus": {
      "type": "table",
      "source": "auto_parts_store/skus.csv",
      "columns": {
        "list_price": "number",
        "unit_cost": "number",
        "lead_weeks": "int",
        "case_pack": "int"
      },
      "description": "The SKUs: part, category, tier, sibling in the other tier, prices, cost, lead time and case pack."
    },
    "history": {
      "type": "table",
      "source": "auto_parts_store/history.csv",
      "columns": {
        "units": "int",
        "stockout": "int",
        "stock": "int",
        "price": "number",
        "promo": "number",
        "price_effect": "number"
      },
      "description": "Weekly sales history the demand patterns are fitted from: units sold, whether stock ran out, units on hand, price, promotion depth and price relative to list (the price response's driver)."
    },
    "orders": {
      "type": "table",
      "source": "auto_parts_store/orders.csv",
      "columns": {
        "placed": "int",
        "arrived": "int",
        "qty": "int",
        "lead_time": "number",
        "factor": "number"
      },
      "description": "Purchase orders as they arrived: SKU, week placed and week arrived (weeks of the history), units, lead time in weeks and the lead time over the SKU's usual one — the lead-time pattern is fitted from them."
    },
    "categories": {
      "type": "table",
      "default": [
        {
          "category": "brake_pads",
          "promo_offset": 2
        },
        {
          "category": "batteries",
          "promo_offset": 4
        },
        {
          "category": "wipers",
          "promo_offset": 0
        }
      ],
      "description": "Each category's promotion calendar offset (weeks)."
    },
    "policy": {
      "type": "enum",
      "values": [
        "lean",
        "service"
      ],
      "default": "lean",
      "description": "lean: the store's rule — reorder when stock covers less than lean_cover of the lead time at the average of the last 8 weeks' sales, up to 1.5 weeks more | service: order up to the expected demand over lead time and review plus safety stock for the category's service level."
    },
    "lean_cover": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "description": "The lean rule reorders when stock covers less than this share of the lead time at the trailing 8-week average."
    },
    "service_level": {
      "type": "number",
      "default": 0.95,
      "min": 0.5,
      "max": 0.999,
      "description": "Chance of not running out before an order can arrive (service policy)."
    },
    "service_level_by_category": {
      "type": "map",
      "default": {},
      "description": "A service level per category, {category: level}; categories left out use service_level. A decision fg_env.optimise can search."
    },
    "holding_rate": {
      "type": "number",
      "default": 0.004,
      "min": 0,
      "description": "Holding cost per week, as a share of the unit cost."
    },
    "order_cost": {
      "type": "number",
      "default": 6.0,
      "min": 0,
      "description": "Cost of placing one order.",
      "unit": "USD"
    },
    "promo_every": {
      "type": "int",
      "default": 6,
      "min": 2,
      "description": "Weeks between a category's promotions."
    },
    "promo_depth": {
      "type": "number",
      "default": 0.2,
      "min": 0,
      "max": 0.9,
      "description": "Share off during a promotion."
    },
    "promo_dip": {
      "type": "number",
      "default": 0.25,
      "min": 0,
      "max": 1,
      "description": "Demand lost after a promotion per unit of remembered promotion (assumed, not fitted)."
    },
    "promo_retain": {
      "type": "number",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "description": "Share of the remembered promotion kept each week."
    },
    "cross_elasticity": {
      "type": "number",
      "default": 0.8,
      "min": 0,
      "description": "How strongly demand moves between tiers when their relative price changes (assumed)."
    },
    "spill_share": {
      "type": "number",
      "default": 0.3,
      "min": 0,
      "max": 1,
      "description": "Share of a premium stockout's lost demand that buys the value tier instead."
    },
    "premium_markup": {
      "type": "number",
      "default": 0.0,
      "min": -0.5,
      "max": 1,
      "description": "Extra share on premium prices (a pricing experiment)."
    },
    "record_history": {
      "type": "bool",
      "default": false,
      "description": "Post every SKU-week to the history record (the truth arm does)."
    },
    "parameter_uncertainty": {
      "type": "number",
      "default": 1,
      "min": 0,
      "description": "Scales the standard errors of fitted pattern parameters: 1 draws each run's parameters around their estimates, 0 uses the estimates as they are."
    },
    "growth_rate": {
      "type": "number",
      "default": 0.0009755936630534346,
      "description": "Pattern 'growth', rate: fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "growth_rate_se": {
      "type": "number",
      "default": 0.000319268707609996,
      "description": "Standard error of growth_rate."
    },
    "promo_lift": {
      "type": "number",
      "default": 1.3051619817023157,
      "description": "Pattern 'promo', lift: fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "promo_lift_se": {
      "type": "number",
      "default": 0.34949841409828725,
      "description": "Standard error of promo_lift."
    },
    "sales_dispersion": {
      "type": "number",
      "default": 5.871304568440537,
      "description": "Pattern 'sales', dispersion: fitted by fg_env.fit_patterns from $inputs.history (method of moments around the fitted means)."
    },

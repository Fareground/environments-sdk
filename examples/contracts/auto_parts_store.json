          "elasticity": -0.20544061059909166,
          "elasticity_se": 0.3729962186591878
        },
        {
          "category": "wipers",
          "elasticity": -1.7575615808944816,
          "elasticity_se": 0.31895549659022887
        }
      ],
      "description": "Pattern 'price_effect', one row per key: elasticity fitted by fg_env.fit_patterns from $inputs.history (joint count regression)."
    },
    "demand_fit": {

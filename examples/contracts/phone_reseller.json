{
  "fg_env": "1",
  "name": "Used-iPhone reseller: graded stock, two channels and launches",
  "description": "A bulk reseller of used iPhones (four models, four grades each) on the economy demand and replenishment modes. A graded phone's wholesale value is the model's price when new × a resale share × its grade, falling with age and stepping down over three weeks at every later iPhone launch (a lifecycle pattern). Retail buyers online pay the listing (value × markup, less the marketplace fee), answer the markup with a fitted elasticity and a weekday profile, and send 5–13% of phones back; wholesale buyers take bulk at a share of value and rarely return. The reseller buys graded lots every week up to a few weeks of forecast demand (or to a service level), paying a share of value plus refurbishment, within a lot minimum, case packs and a weekly budget, with delivery and grading times drawn per lot. Demand and lead times are fitted from bundled sales and purchase histories that the `truth` arm records (examples/phone_reseller_study.py regenerates them, compares channels, forks a new-model launch and validates on held-out months).",
  "brief": {
    "situation": "A reseller buying graded used iPhones in bulk and selling them to retail buyers online and to wholesale buyers."
  },
  "clock": {
    "rounds": "$inputs.days",
    "unit": "day",
    "start": "$inputs.start"
  },
  "inputs": {
    "start": {
      "type": "text",
      "default": "2026-08-03",
      "description": "The first day."
    },
    "days": {
      "type": "int",
      "default": 90,
      "min": 1,
      "description": "Days to run."
    },
    "items": {
      "type": "table",
      "source": "phone_reseller/items.csv",
      "columns": {
        "grade_factor": "number",
        "refurb_cost": "number",
        "retail_return": "number",
        "retail_rate": "number",
        "wholesale_rate": "number"
      },
      "description": "Item lines (model × grade): grade value factor, refurbishment per unit, retail return rate, and the demand each line saw when the history began."
    },
    "models": {
      "type": "table",
      "default": [
        {
          "model": "14",
          "launch": "2022-09-16",
          "msrp": 799,
          "later": [
            "2023-09-22",
            "2024-09-20",
            "2025-09-19"
          ]
        },
        {
          "model": "15",
          "launch": "2023-09-22",
          "msrp": 799,
          "later": [
            "2024-09-20",
            "2025-09-19"
          ]
        },
        {
          "model": "16P",
          "launch": "2024-09-20",
          "msrp": 999,
          "later": [
            "2025-09-19"
          ]
        },
        {
          "model": "17",
          "launch": "2025-09-19",
          "msrp": 829,
          "later": []
        }
      ],
      "description": "Models: launch date, price when new, and the launches since."
    },
    "history": {
      "type": "table",
      "source": "phone_reseller/history.csv",
      "columns": {
        "units": "int",
        "stockout": "int",
        "stock": "int",
        "price": "number"
      },
      "description": "Daily sales per item and channel: units, whether stock ran out, units on hand, price and the retail markup (retail rows only)."
    },
    "orders": {
      "type": "table",
      "source": "phone_reseller/orders.csv",
      "columns": {
        "placed": "int",
        "arrived": "int",
        "qty": "int",
        "lead_time": "number",
        "factor": "number"
      },
      "description": "Lots bought per item: day placed and day listed, units, days from purchase to listing, and that over the usual time."
    },
    "opening_stock": {
      "type": "map",
      "default": {},
      "description": "Phones on hand per item at the start, {item: units}; items left out start with 20."
    },
    "opening_orders": {
      "type": "map",

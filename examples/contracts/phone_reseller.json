    {
      "type": "phone",
      "from": "$inputs.items",
      "id": "{$row.item}",
      "name": "iPhone {$row.model} grade {$row.grade}",
      "props": {
        "model": "$row.model",
        "grade": "$row.grade",
        "refurb_cost": "$row.refurb_cost",
        "retail_return": "$row.retail_return",
        "stock": "$get($inputs.opening_stock, $row.item, 20)",
        "buying_pipeline": "$get($inputs.opening_orders, $row.item, [])",
        "buying_on_order": "$sum($get($inputs.opening_orders, $row.item, []), $it[1])"
      }
    }
  ],
  "patterns": {
    "age_decay": {
      "kind": "trend",
      "form": "exponential",
      "table": "$inputs.models",
      "column": "model",
      "rate": "-$inputs.monthly_decay / 30.44",
      "origin": "$row.launch",
      "description": "Value lost with age since the model's launch."
    },
    "launches": {
      "kind": "lifecycle",
      "table": "$inputs.models",
      "column": "model",
      "start": "$row.later + ([$inputs.new_launch_date] if $inputs.new_launch else [])",
      "before": 1,
      "peak": "$inputs.launch_drop",
      "ramp": 21,
      "description": "Every later iPhone launch cuts an older model's value, over three weeks."
    },
    "value": {
      "kind": "product",
      "table": "$inputs.items",
      "column": "item",
      "scale": "$dict($inputs.models, $it.model, $it.msrp)[$row.model] * $inputs.resale_share * $row.grade_factor",
      "of": [
        {
          "pattern": "age_decay",
          "key": "$row.model"
        },
        {
          "pattern": "launches",
          "key": "$row.model"
        }
      ],
      "unit": "USD",
      "description": "A graded phone's wholesale value today."
    },
    "weekday": {
      "kind": "seasonal",
      "period": "week",
      "profile": "$inputs.weekday_profile",
      "description": "Retail buyers by day of the week, Monday first.",
      "uncertainty": {
        "profile": "$map($inputs.weekday_profile_se, $it * $inputs.parameter_uncertainty)"
      }
    },
    "retail_demand": {
      "kind": "product",
      "table": "$inputs.retail_demand_fit",
      "column": "item",
      "scale": "$row.scale",
      "of": [
        "weekday"
      ],
      "description": "Retail buyers a day for an item at the fair markup.",
      "fit": {
        "data": "$inputs.history",
        "where": "$row.segment == retail",
        "value": "units",
        "time": "time",
        "key": "item",
        "censored": "stockout",
        "noise": "sales",
        "x": {
          "retail_price_effect": "retail_price_effect"
        }
      },
      "uncertainty": {
        "scale": "$row.scale_se * $inputs.parameter_uncertainty"
      }
    },
    "retail_price_effect": {
      "kind": "elasticity",
      "elasticity": "$inputs.retail_price_effect_elasticity",
      "reference": 1.31,
      "description": "Retail buyers answer the listing's markup over value.",
      "uncertainty": {
        "elasticity": "$inputs.retail_price_effect_elasticity_se * $inputs.parameter_uncertainty"
      }
    },
    "markup_wiggle": {
      "kind": "noise",
      "keys": [
        "A",
        "B",
        "C",
        "D"
      ],
      "dist": "lognormal",
      "mean": 0,
      "sd": "$inputs.markup_wiggle",
      "description": "Day-to-day repricing around the markup, per grade."
    },
    "sales": {
      "kind": "counts",
      "dispersion": "$inputs.sales_dispersion",
      "description": "Retail buyers a day, around the expected number."
    },
    "wholesale_trend": {
      "kind": "trend",
      "form": "exponential",
      "rate": "$inputs.wholesale_trend_rate",
      "origin": "2026-01-01",
      "description": "Growth of wholesale buyers' demand.",
      "uncertainty": {
        "rate": "$inputs.wholesale_trend_rate_se * $inputs.parameter_uncertainty"
      }
    },
    "wholesale_demand": {
      "kind": "product",
      "table": "$inputs.wholesale_demand_fit",
      "column": "item",
      "scale": "$row.scale",
      "of": [
        "wholesale_trend"
      ],
      "description": "Phones a day wholesale buyers take of an item.",
      "fit": {
        "data": "$inputs.history",
        "where": "$row.segment == wholesale",
        "value": "units",
        "time": "time",
        "key": "item",
        "censored": "stockout",
        "noise": "bulk"
      },
      "uncertainty": {
        "scale": "$row.scale_se * $inputs.parameter_uncertainty"
      }
    },
    "bulk": {
      "kind": "counts",
      "dispersion": "$inputs.bulk_dispersion",
      "description": "Wholesale takes come in lumps."
    },
    "lead_noise": {
      "kind": "noise",
      "dist": "lognormal",
      "mean": "$inputs.lead_noise_mean",
      "sd": "$inputs.lead_noise_sd",
      "description": "How far a lot's delivery and grading run from the usual days.",
      "fit": {
        "data": "$inputs.orders",
        "value": "factor"
      },
      "uncertainty": {
        "mean": "$inputs.lead_noise_mean_se * $inputs.parameter_uncertainty"
      }
    }
  },
  "mechanisms": {
    "money": {
      "kind": "economy",
      "mode": "ledger",
      "who": "reseller",
      "currencies": {
        "cash": {
          "start": "$inputs.cash",
          "unit": "USD"
        }
      }
    },
    "sales": {
      "kind": "economy",
      "mode": "demand",
      "items": "phone",
      "stock": "stock",
      "group": "$it.model",
      "price": "$round($pattern.value($it) * $get($inputs.retail_markup, $it.grade) * $pattern.markup_wiggle($it.grade) * (1 - $inputs.retail_fee), 2)",
      "cost": "$pattern.value($it) * $inputs.bid_share + $it.refurb_cost",
      "segment": "retail",
      "rate": "retail_demand",
      "noise": "sales",
      "factors": [
        {
          "pattern": "retail_price_effect",
          "driver": "$get($inputs.retail_markup, $it.grade) * $pattern.markup_wiggle($it.grade)"
        }
      ],
      "returns": {
        "rate": "$it.retail_return",
        "delay": 10,
        "restock": 0.7
      },
      "segments": {
        "wholesale": {
          "rate": "wholesale_demand",
          "noise": "bulk",
          "price": "$round($pattern.value($it) * $inputs.wholesale_share, 2)",
          "returns": {
            "rate": 0.015,
            "delay": 5,
            "restock": 0.9
          }
        }
      },
      "account": "reseller",
      "currency": "cash",
      "record": "$inputs.record_history"
    },
    "buying": {
      "kind": "economy",
      "mode": "replenishment",
      "demand": "sales",
      "policy": "'order_up_to' if $inputs.buy_policy == cover else 'service'",
      "order_up_to": "$ceil($forecast * $inputs.cover_days)",
      "service_level": "$inputs.service_level",
      "review_every": 7,
      "lead_time": {
        "pattern": "lead_noise",
        "scale": "$inputs.lead_days"
      },
      "min_order": "$inputs.lot_minimum",
      "case_pack": 5,
      "budget": "$inputs.weekly_budget",
      "holding_cost": "$pattern.value($it) * $inputs.capital_rate_daily",
      "record": "$inputs.record_history"
    }
  },

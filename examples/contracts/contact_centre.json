    "truth": {
      "description": "The centre that generated history.csv: the true parameters, used by examples/contact_centre_history.py only.",
      "inputs": {
        "parameter_uncertainty": 0,
        "aht_sec": 380.0,
        "aht_cv": 0.6,
        "patience_sec": 160.0,
        "outage_patience_share": 0.55,

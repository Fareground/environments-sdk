          12,
          11
        ],
        "outage_uplift": 3.164
      }
    },
    "outage_with_callbacks": {
      "description": "the outage, with callbacks offered",
      "inputs": {
        "staffing": [
          15,
          22,
          24,
          29,
          27,
          28,
          23,
          24,
          24,
          27,
          26,
          25,
          22,
          22,

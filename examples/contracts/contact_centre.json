          14,
          12,
          11
        ],
        "outage_uplift": 3.164,
        "callbacks": true
      }
    },
    "callbacks": {
      "description": "callbacks offered on a normal day with the recommended plan",
      "inputs": {
        "staffing": [
          15,
          22,
          24,
          29,
          27,
          28,
          23,

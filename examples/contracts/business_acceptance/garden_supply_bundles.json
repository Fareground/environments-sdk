{
  "fg_env": "1",
  "name": "Garden supply: weather-sensitive products and constrained starter bundles",
  "description": "A round-based business acceptance scenario; all behavioral parameters are explicit assumptions, not fitted market estimates.",
  "clock": {
    "rounds": "$inputs.days",
    "unit": "day"
  },
  "inputs": {
    "days": {
      "type": "int",
      "default": 21,
      "min": 1,
      "max": 120
    },
    "demand_scale": {
      "type": "number",
      "default": 1,
      "min": 0
    },
    "focal_price": {
      "type": "number",
      "default": 1,
      "min": 0.6,
      "max": 1.8
    },
    "inventory_cover": {
      "type": "number",
      "default": 1.2,
      "min": 0,
      "max": 3
    },
    "use_demand_signal": {
      "type": "bool",
      "default": true
    },
    "lead_time": {
      "type": "int",
      "default": 2,
      "min": 1,
      "max": 14
    },
    "disruption_delay": {
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 14
    },
    "weather": {
      "type": "list",
      "default": [
        0.7,
        0.8,
        1,
        1.2,
        1.5,
        1.3,
        0.9
      ]
    }
  },
  "world": {
    "weather": 1.0,
    "shipping_delay": 2,
    "requests": 0,
    "unmet": 0,
    "bundles_requested": 0,
    "bundles_sold": 0,
    "substitutions": 0
  },
  "types": {
    "merchant": {
      "agent": true,
      "policy": "planner",
      "props": {
        "cash": {
          "type": "number",
          "default": 1800,
          "min": 0
        },
        "initial_cash": {
          "type": "number",
          "default": 1800,
          "min": 0
        },
        "revenue": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "spent": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "refunds": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "refunds_due": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "focal": false
      }
    },
    "product": {
      "props": {
        "owner": "",
        "category": "",
        "price": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "reference": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "cost": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "base": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "forecast": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "forecast_error": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "weather_power": {
          "type": "number",
          "default": 1
        },
        "return_rate": {
          "type": "number",
          "default": 0,
          "min": 0
        },
        "stock": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "initial": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "ordered": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "transit": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "delivered": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "returned": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "returns_due": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "sold": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "waste": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "requested": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "today_requested": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "today_sold": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "unmet": {
          "type": "int",
          "default": 0,
          "min": 0
        },
        "planned": {
          "type": "int",
          "default": 0,
          "min": 0
        }
      }
    }
  },
  "entities": {
    "atlas": {
      "type": "merchant",
      "name": "Atlas",
      "props": {
        "focal": true
      }
    },
    "beacon": {
      "type": "merchant",
      "name": "Beacon"
    },
    "atlas_seed": {
      "type": "product",
      "name": "Atlas seed",
      "props": {
        "owner": "atlas",
        "category": "seed",
        "reference": 3,
        "price": 3,
        "cost": 1,
        "base": 12,
        "forecast": 12,
        "initial": 30,
        "stock": 30,
        "weather_power": 0.5,
        "return_rate": 0
      }
    },
    "atlas_plant": {
      "type": "product",
      "name": "Atlas plant",
      "props": {
        "owner": "atlas",
        "category": "plant",
        "reference": 8,
        "price": 8,
        "cost": 3,
        "base": 8,
        "forecast": 8,
        "initial": 22,
        "stock": 22,
        "weather_power": 1.3,
        "return_rate": 0
      }
    },
    "atlas_pot": {
      "type": "product",
      "name": "Atlas pot",
      "props": {
        "owner": "atlas",
        "category": "pot",
        "reference": 5,
        "price": 5,
        "cost": 2,
        "base": 8,
        "forecast": 8,
        "initial": 22,
        "stock": 22,
        "weather_power": 0.2,
        "return_rate": 0
      }
    },
    "beacon_seed": {
      "type": "product",
      "name": "Beacon seed",
      "props": {
        "owner": "beacon",
        "category": "seed",
        "reference": 3,
        "price": 3,
        "cost": 1,
        "base": 12,
        "forecast": 12,
        "initial": 30,
        "stock": 30,
        "weather_power": 0.5,
        "return_rate": 0
      }
    },
    "beacon_plant": {
      "type": "product",
      "name": "Beacon plant",
      "props": {
        "owner": "beacon",
        "category": "plant",
        "reference": 8,
        "price": 8,
        "cost": 3,
        "base": 8,
        "forecast": 8,
        "initial": 22,
        "stock": 22,
        "weather_power": 1.3,
        "return_rate": 0
      }
    },
    "beacon_pot": {
      "type": "product",
      "name": "Beacon pot",
      "props": {
        "owner": "beacon",
        "category": "pot",
        "reference": 5,
        "price": 5,
        "cost": 2,
        "base": 8,
        "forecast": 8,
        "initial": 22,
        "stock": 22,
        "weather_power": 0.2,
        "return_rate": 0
      }
    }
  },
  "patterns": {
    "arrivals": {
      "kind": "counts",
      "dist": "negative_binomial",
      "dispersion": 12,
      "keys": "product"
    },
    "bundle_arrivals": {
      "kind": "counts",
      "dist": "poisson",
      "keys": "merchant"
    }
  },
  "brief": {
    "situation": "Garden supply: weather-sensitive products and constrained starter bundles",
    "roles": {
      "merchant": "Manage prices and replenishment across your products. Balance operating profit, cash, customer service and excess inventory."
    },
    "rules": "Each day, delayed deliveries arrive first. Review your operating position and competitors, then plan each product once. Customers shop after both merchants decide. Prices affect demand and rival prices create substitution pressure. Orders cost cash immediately and arrive after the announced delay. Demand signals record requested units separately from sales. Forecasts update after trading. Parameters are illustrative assumptions. After individual purchases, customers request starter bundles containing one of each product from one merchant, priced at 87.5% of their individual total. A bundle is fulfilled only when all three components are available. Unit-demand metrics count all three requested components."
  },
  "actions": {
    "plan": {
      "by": "merchant",
      "description": "Set a product price and order replenishment; each product can be planned once today.",
      "params": {
        "product": {
          "type": "entity",
          "of": "product",
          "where": "$it.owner == $actor.id"
        },
        "price": {
          "type": "number",
          "min": "$params.product.cost",
          "max": "3*$params.product.reference"
        },
        "qty": {
          "type": "int",
          "min": 0,
          "max": 300
        }
      },
      "when": [
        {
          "expr": "$params.product.planned != $round",
          "why": "This product has already been planned today."
        },
        {
          "expr": "$actor.cash-$actor.refunds_due >= $params.qty*$params.product.cost",
          "why": "There is not enough cash for this order."
        }
      ],
      "do": [
        "$params.product.price = $params.price",
        "$params.product.planned = $round",
        "$actor.cash -= $params.qty*$params.product.cost",
        "$actor.spent += $params.qty*$params.product.cost",
        "$params.product.ordered += $params.qty",
        "$params.product.transit += $params.qty",
        {
          "if": "$params.qty > 0",
          "then": [
            {
              "after": "$world.shipping_delay",
              "do": [
                "$params.product.stock += $params.qty",
                "$params.product.delivered += $params.qty",
                "$params.product.transit -= $params.qty"
              ]
            }
          ]
        }
      ],
      "outcome": "Price set to {$params.price}; {$params.qty} units ordered, arriving in {$world.shipping_delay} days."
    }
  },
  "policies": {
    "planner": {
      "repeat": true,
      "rules": [
        {
          "each": "$filter(product, $it.owner == $actor.id)",
          "when": "$it.planned != $round",
          "do": "plan",
          "with": {
            "product": "$it",
            "price": "$max($it.cost, $it.reference * ($inputs.focal_price if $actor.focal else 1))",
            "qty": "$min(300, $floor(($actor.cash-$actor.refunds_due)/$it.cost), $max(0, $ceil($it.forecast*($world.shipping_delay+1)*$inputs.inventory_cover - $it.stock - $it.transit)))"
          }
        }
      ]
    }
  },
  "stages": [
    {
      "name": "planning",
      "actions": [
        "plan"
      ],
      "max_actions": 3,
      "max_calls": 6
    }
  ],
  "events": [
    {
      "phase": "start",
      "do": [
        "$world.weather = $inputs.weather[($round-1) % $len($inputs.weather)]",
        "$world.shipping_delay = $inputs.lead_time + ($inputs.disruption_delay if $round >= 7 and $round <= 9 else 0)"
      ]
    },
    {
      "phase": "end",
      "do": [
        {
          "each": "product",
          "do": [
            "$it.today_requested = 0",
            "$it.today_sold = 0",
            "$it.unmet = 0"
          ]
        },
        {
          "each": "product",
          "do": [
            "$rival = $avg($filter(product, $it.category == $outer.category and $it.owner != $outer.owner), $it.price/$it.reference)",
            "$mean = $it.base*$inputs.demand_scale*($world.weather**$it.weather_power)*(($it.price/$it.reference)**-1.4)*($rival**0.6)",
            "$it.today_requested = $pattern.arrivals($mean, $it)",
            "$it.requested += $it.today_requested",
            "$world.requests += $it.today_requested"
          ]
        },
        {
          "each": "product",
          "do": [
            "$qty = $min($it.stock, $it.today_requested)",
            "$merchant = $entity($it.owner)",
            "$paid = $it.price",
            "$units = $qty",
            "$it.stock -= $units",
            "$it.sold += $units",
            "$it.today_sold += $units",
            "$merchant.cash += $units*$paid",
            "$merchant.revenue += $units*$paid",
            "$it.unmet = $it.today_requested-$qty"
          ]
        },
        {
          "each": "merchant",
          "do": [
            "$parts = $filter(product, $it.owner == $outer.id)",
            "$bundle_price = 0.875*$sum($parts, $it.price)",
            "$want = $pattern.bundle_arrivals(3*$inputs.demand_scale*$world.weather, $it)",
            "$qty = $min($want, $min($parts, $it.stock))",
            "$world.bundles_requested += $want",
            "$world.bundles_sold += $qty",
            "$it.cash += $qty*$bundle_price",
            "$it.revenue += $qty*$bundle_price",
            {
              "each": "$parts",
              "do": [
                "$it.stock -= $qty",
                "$it.sold += $qty",
                "$it.today_sold += $qty",
                "$it.today_requested += $want",
                "$it.requested += $want",
                "$it.unmet += $want-$qty",
                "$world.requests += $want"
              ]
            }
          ]
        },
        {
          "each": "product",
          "do": [
            "$world.unmet += $it.unmet",
            "$it.forecast_error += $abs($it.forecast-$it.today_requested)",
            "$it.forecast = 0.7*$it.forecast + 0.3*($it.today_requested if $inputs.use_demand_signal else $it.today_sold)"
          ]
        }
      ]
    }
  ],
  "views": {
    "position": {
      "for": "merchant",
      "title": "Operating position",
      "show": "Cash {$actor.cash|money}, reserved refunds {$actor.refunds_due|money}; cash change {$actor.revenue-$actor.spent-$actor.refunds|money}. Weather index {$world.weather}; new order delay {$world.shipping_delay} days."
    },
    "own_products": {
      "for": "merchant",
      "title": "Your products",
      "of": "$filter(product, $it.owner == $actor.id)",
      "show": "{name}: price {price|money}, stock {stock}, in transit {transit}; yesterday requests {today_requested}, sold {today_sold}; forecast {forecast|1} units/day."
    },
    "competition": {
      "for": "merchant",
      "title": "Public competitor prices",
      "of": "$filter(product, $it.owner != $actor.id)",
      "show": "{name}: {price|money}"
    }
  },
  "invariants": [
    {
      "expr": "$all(product, $it.initial + $it.delivered + $it.returned == $it.stock + $it.sold + $it.waste)",
      "why": "Product units must be accounted for."
    },
    {
      "expr": "$all(product, $it.ordered == $it.delivered + $it.transit)",
      "why": "Every ordered unit is delivered or still in transit."
    },
    {
      "expr": "$all(merchant, $abs($it.cash - ($it.initial_cash + $it.revenue - $it.spent - $it.refunds)) < 0.000001)",
      "why": "Cash must reconcile with receipts, purchases and refunds."
    },
    {
      "expr": "$all(merchant, $it.cash+0.000001 >= $it.refunds_due)",
      "why": "Promised refunds must remain funded."
    }
  ],
  "metrics": {
    "sales": "$sum(product, $it.today_sold)",
    "requested": "$sum(product, $it.today_requested)",
    "stock": "$sum(product, $it.stock)"
  },
  "outputs": {
    "sales": "$sum(product, $it.sold)",
    "requests": "$world.requests",
    "unmet": "$world.unmet",
    "waste": "$sum(product, $it.waste)",
    "returns": "$sum(product, $it.returned)",
    "in_transit": "$sum(product, $it.transit)",
    "stock": "$sum(product, $it.stock)",
    "cash_change": "$sum(merchant, $it.revenue-$it.spent-$it.refunds)",
    "operating_profit": "$sum(merchant, $it.revenue-$it.refunds-$it.refunds_due)-$sum(product, ($it.sold-$it.returned-$it.returns_due+$it.waste)*$it.cost)",
    "inventory_value": "$sum(product, ($it.stock+$it.transit+$it.returns_due)*$it.cost)",
    "pending_refunds": "$sum(merchant, $it.refunds_due)",
    "forecast_mae": "$sum(product, $it.forecast_error)/($count(product)*$round)",
    "requests_by_product": {
      "type": "map",
      "expr": "$dict(product, $it.id, $it.requested)"
    },
    "sales_by_product": {
      "type": "map",
      "expr": "$dict(product, $it.id, $it.sold)"
    },
    "by_merchant": {
      "type": "map",
      "expr": "$dict(merchant, $it.id, {revenue: $it.revenue, spent: $it.spent, refunds: $it.refunds, cash: $it.cash})"
    },
    "fill_rate": "1 - $world.unmet/$world.requests if $world.requests > 0 else 1",
    "substitutions": "$world.substitutions",
    "bundles_sold": "$world.bundles_sold"
  },
  "arms": {
    "baseline": {
      "inputs": {}
    },
    "thin_stock": {
      "inputs": {
        "inventory_cover": 0.35
      }
    },
    "buffered_stock": {
      "inputs": {
        "inventory_cover": 1.8
      }
    },
    "sales_only_forecast": {
      "inputs": {
        "use_demand_signal": false
      }
    },
    "focal_discount": {
      "inputs": {
        "focal_price": 0.8
      }
    },
    "long_delays": {
      "inputs": {
        "lead_time": 4
      }
    },
    "higher_demand": {
      "inputs": {
        "demand_scale": 1.3
      }
    }
  }
}
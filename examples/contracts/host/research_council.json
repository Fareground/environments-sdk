{
  "fg_env": "1",
  "name": "Research council",
  "description": "A panel of forecasters researches a question with a host search tool, remembers what it found, discusses on a board and submits probability forecasts each round.",
  "brief": {
    "situation": "A panel forecasts: {$inputs.question}",
    "rules": "Each round: research with search (the evidence is yours alone), share arguments on the board, then submit your probability that the answer is yes. Use recall to bring back what you learned in earlier rounds and note to keep something for later. The panel's forecast is the average of the latest forecasts."
  },
  "inputs": {
    "question": {"type": "text", "default": "Will the city's new metro line open before 2028?"}
  },
  "clock": {"rounds": 3, "unit": "round"},
  "types": {
    "panelist": {
      "agent": true,
      "props": {
        "forecast": {"type": "number", "default": 0.5, "min": 0, "max": 1, "private": true},
        "lens": {"type": "text", "default": ""}
      }
    }
  },
  "population": [
    {"type": "panelist", "count": 3, "name": "Panelist {$i}",
     "props": {"lens": "['base rates', 'recent reporting', 'devil advocate'][$i - 1]"},
     "brief": "You reason from {$actor.lens}."}
  ],
  "records": {
    "board": {"fields": {"text": "text"}, "show": "{author}: {text}"}
  },
  "actions": {
    "post": {
      "by": "panelist",
      "description": "Share an argument or a piece of evidence with the panel.",
      "params": {"text": {"type": "text", "max_len": 800, "description": "What you want the panel to read."}},
      "do": [{"post": "board", "text": "$params.text"}]
    },
    "forecast": {
      "by": "panelist",
      "description": "Submit your probability that the answer is yes.",
      "params": {"p": {"type": "number", "min": 0, "max": 1, "description": "Probability of yes."}},
      "do": ["$actor.forecast = $params.p"],
      "private": true,
      "outcome": "Your forecast: {$params.p|pct}.",
      "terminal": true
    }
  },
  "stages": [
    {"name": "discuss", "turns": "sequential", "actions": ["post"], "max_calls": 8},
    {"name": "ballot", "turns": "simultaneous", "actions": ["forecast"], "must_act": true}
  ],
  "mechanisms": {
    "search": {
      "kind": "host_tool", "host": "web_search", "by": "panelist",
      "description": "Search the web for evidence on the question.",
      "max_calls_per_turn": 2, "max_calls_per_run": 5, "stages": ["discuss", "ballot"]
    },
    "memory": {"kind": "mind", "mode": "memory", "who": "panelist", "half_life": 3, "budget": 200, "stages": ["discuss", "ballot"]},
    "story": {"kind": "recap", "record": "board", "every": 2, "fallback": "extract"}
  },
  "views": {
    "panel": {"for": "panelist", "title": "The panel", "of": "panelist", "stages": ["discuss"], "show": "{name} ({lens})"}
  },
  "outputs": {
    "panel_forecast": {"expr": "$round($avg(panelist, $it.forecast), 4)", "type": "number"},
    "spread": {"expr": "$round($max(panelist, $it.forecast) - $min(panelist, $it.forecast), 4)", "type": "number"},
    "searches": {"expr": "$sum(panelist, $it.search_calls)", "type": "int"}
  }
}

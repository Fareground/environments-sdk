{
  "fg_env": "1",
  "name": "Biased pennies",
  "description": "A zero-sum 2x2 matrix game with a lopsided payoff. Its unique equilibrium has both players show heads with probability 1/3; the row player's value is 1/3.",
  "brief": {
    "situation": "The row player (A) and the column player (B) show a coin at the same time.",
    "rules": "Both heads: A wins 3. Both tails: A wins 1. Different sides: B wins 1. What one wins the other loses."
  },
  "clock": {"rounds": 1},
  "world": {
    "payoff": {"type": "map", "default": {
      "heads": {"heads": 3, "tails": -1},
      "tails": {"heads": -1, "tails": 1}
    }}
  },
  "types": {"player": {"agent": true, "props": {
    "seat": 0,
    "side": {"type": "text", "default": "", "private": true},
    "score": 0
  }}},
  "entities": {
    "a": {"type": "player", "name": "A", "props": {"seat": 0}},
    "b": {"type": "player", "name": "B", "props": {"seat": 1}}
  },
  "actions": {"show": {
    "by": "player", "description": "Show heads or tails.", "private": true, "terminal": true,
    "params": {"side": {"type": "enum", "values": ["heads", "tails"]}},
    "do": ["$actor.side = $params.side"]
  }},
  "stages": [{"name": "show", "turns": "simultaneous", "must_act": true}],
  "events": [{"phase": "end", "do": [
    "$a = $entity('a')", "$b = $entity('b')",
    "$a.score = $world.payoff[$a.side][$b.side]", "$b.score = -$a.score",
    {"emit": "shown", "say": "A showed {$a.side}; B showed {$b.side}."}
  ]}],
  "game": {"players": "player", "seat": "$it.seat", "returns": "$actor.score", "utility": "zero_sum",
           "min_return": -3, "max_return": 3},
  "outputs": {"a_score": {"expr": "$entity('a').score", "type": "number"}}
}

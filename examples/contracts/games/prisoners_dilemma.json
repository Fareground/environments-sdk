{
  "fg_env": "2",
  "name": "Prisoner's dilemma",
  "description": "The one-shot general-sum matrix game (T=5, R=3, P=1, S=0). Defecting strictly dominates, so the only equilibrium is mutual defection (1, 1).",
  "brief": {
    "situation": "Two players each choose to cooperate or defect, at the same time.",
    "rules": "Both cooperate: 3 each. Both defect: 1 each. One defects while the other cooperates: the defector scores 5 and the cooperator 0. A player who does not choose cooperates."
  },
  "clock": {"rounds": 1},
  "world": {
    "payoff": {
      "type": "map",
      "default": {"cooperate": {"cooperate": 3, "defect": 0}, "defect": {"cooperate": 5, "defect": 1}}
    }
  },
  "types": {
    "player": {
      "agent": true,
      "props": {"seat": 0, "move": {"type": "text", "default": "cooperate", "private": true}, "score": 0},
      "score": {"seat": "$it.seat", "utility": "general_sum", "min": 0, "max": 5, "value": "$it.score"}
    }
  },
  "entities": {
    "a": {"type": "player", "name": "A", "props": {"seat": 0}},
    "b": {"type": "player", "name": "B", "props": {"seat": 1}}
  },
  "actions": {
    "choose": {
      "by": "player",
      "description": "Cooperate or defect.",
      "terminal": true,
      "params": {"move": {"type": "enum", "values": ["cooperate", "defect"]}},
      "do": ["$actor.move = $params.move"],
      "announce": false
    }
  },
  "stages": [{"name": "choose", "turns": "simultaneous", "must_act": true}],
  "events": [
    {
      "on": "round.end",
      "do": [
        "$a = $entity('a')",
        "$b = $entity('b')",
        "$a.score = $world.payoff[$a.move][$b.move]",
        "$b.score = $world.payoff[$b.move][$a.move]",
        "$shown_a = $a.move",
        "$shown_b = $b.move",
        {"emit": "shown", "say": "A chose to {$shown_a}; B chose to {$shown_b}."}
      ]
    }
  ],
  "outputs": {"a_score": {"expr": "$entity('a').score", "type": "number"}}
}

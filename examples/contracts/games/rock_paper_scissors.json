{
  "fg_env": "1",
  "name": "Rock paper scissors",
  "description": "The one-shot zero-sum matrix game. Its unique equilibrium plays each move with probability 1/3; the game's value is 0.",
  "brief": {
    "situation": "Two players show rock, paper or scissors at the same time.",
    "rules": "Rock beats scissors, scissors beats paper and paper beats rock. A win scores 1, a loss -1 and a tie 0."
  },
  "clock": {"rounds": 1},
  "world": {
    "payoff": {"type": "map", "default": {
      "rock": {"rock": 0, "paper": -1, "scissors": 1},
      "paper": {"rock": 1, "paper": 0, "scissors": -1},
      "scissors": {"rock": -1, "paper": 1, "scissors": 0}
    }}
  },
  "types": {"player": {"agent": true, "props": {
    "seat": 0,
    "move": {"type": "text", "default": "", "private": true},
    "score": 0
  }}},
  "entities": {
    "a": {"type": "player", "name": "A", "props": {"seat": 0}},
    "b": {"type": "player", "name": "B", "props": {"seat": 1}}
  },
  "actions": {"throw": {
    "by": "player", "description": "Show your move.", "private": true, "terminal": true,
    "params": {"move": {"type": "enum", "values": ["rock", "paper", "scissors"]}},
    "do": ["$actor.move = $params.move"]
  }},
  "stages": [{"name": "throw", "turns": "simultaneous", "must_act": true}],
  "events": [{"phase": "end", "do": [
    "$a = $entity('a')", "$b = $entity('b')",
    "$a.score = $world.payoff[$a.move][$b.move]", "$b.score = $world.payoff[$b.move][$a.move]",
    {"emit": "shown", "say": "A showed {$a.move}; B showed {$b.move}."}
  ]}],
  "game": {"players": "player", "seat": "$it.seat", "returns": "$actor.score", "utility": "zero_sum",
           "min_return": -1, "max_return": 1},
  "outputs": {"a_score": {"expr": "$entity('a').score", "type": "number"}}
}

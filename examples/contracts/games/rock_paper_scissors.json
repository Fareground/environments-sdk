{
  "fg_env": "2",
  "name": "Rock paper scissors",
  "description": "The one-shot zero-sum matrix game. Its unique equilibrium plays each move with probability 1/3; the game's value is 0.",
  "brief": {
    "situation": "Two players show rock, paper or scissors at the same time.",
    "rules": "Rock beats scissors, scissors beats paper and paper beats rock. A win scores 1, a loss -1 and a tie 0. A player who shows nothing loses (a tie if neither shows)."
  },
  "clock": {"rounds": 1},
  "world": {
    "payoff": {
      "type": "map",
      "default": {
        "rock": {"rock": 0, "paper": -1, "scissors": 1},
        "paper": {"rock": 1, "paper": 0, "scissors": -1},
        "scissors": {"rock": -1, "paper": 1, "scissors": 0}
      }
    }
  },
  "types": {
    "player": {
      "agent": true,
      "props": {"seat": 0, "move": {"type": "text", "default": "", "private": true}, "score": 0},
      "score": {"seat": "$it.seat", "utility": "zero_sum", "min": -1, "max": 1, "value": "$it.score"}
    }
  },
  "entities": {
    "a": {"type": "player", "name": "A", "props": {"seat": 0}},
    "b": {"type": "player", "name": "B", "props": {"seat": 1}}
  },
  "actions": {
    "throw": {
      "by": "player",
      "description": "Show your move.",
      "terminal": true,
      "params": {"move": {"type": "enum", "values": ["rock", "paper", "scissors"]}},
      "do": ["$actor.move = $params.move"],
      "announce": false
    }
  },
  "stages": [{"name": "throw", "turns": "simultaneous", "must_act": true}],
  "events": [
    {
      "on": "round.end",
      "do": [
        "$a = $entity('a')",
        "$b = $entity('b')",
        "$a.score = 0 if $a.move == $b.move else -1 if $a.move == '' else 1 if $b.move == '' else $world.payoff[$a.move][$b.move]",
        "$b.score = -$a.score",
        "$shown_a = $a.move",
        "$shown_b = $b.move",
        {"emit": "shown", "say": "A showed {$shown_a or 'nothing'}; B showed {$shown_b or 'nothing'}."}
      ]
    }
  ],
  "outputs": {"a_score": {"expr": "$entity('a').score", "type": "number"}}
}

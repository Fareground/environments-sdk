{
  "fg_env": "1",
  "name": "Dungeon skirmish",
  "description": "Three heroes and three monsters fight on a 6x6 dungeon floor with forest cover, a swamp, lava and a wall: poison, stuns and shields, cooldowns and charges, channeled fireballs, initiative by speed, and victory to the last team standing or the healthier team when time runs out.",
  "inputs": {
    "rounds": {"type": "int", "default": 15, "min": 3, "max": 60, "description": "Rounds before the healthier team wins"},
    "fireball_damage": {"type": "number", "default": 6, "min": 1, "description": "Damage to the fireball's target"}
  },
  "brief": {
    "situation": "A torch-lit dungeon floor, six squares by six. The heroes (knight, rogue, mage) entered from the south; the orc warband (orc chief, goblin, shaman) holds the north. Forest squares give cover, the swamp slows, lava burns and a wall blocks the middle.",
    "rules": "Each round units act in order of speed. On your turn you may move one square and take one combat action. Damage is attack minus the target's armor (at least 1). Poison hurts every round and stacks; a stun costs the target its next round; a shield adds armor. Some actions need to cool down or use charges. A fireball takes a round to channel and is lost if the caster is stunned. A unit at 0 health falls. The last team standing wins; after the last round the team with more health left wins.",
    "roles": {
      "unit": "You fight for your team ({team}). Keep your allies alive and bring the enemy down."
    }
  },
  "clock": {"rounds": "$inputs.rounds", "unit": "round"},
  "space": {"grid": {"rows": 6, "cols": 6}},
  "types": {
    "unit": {
      "agent": true,
      "policy": "tactician",
      "props": {
        "team": {"type": "enum", "values": ["heroes", "monsters"], "default": "heroes"},
        "role": {"type": "enum", "values": ["fighter", "skirmisher", "caster"], "default": "fighter"},
        "hp": {"type": "int", "default": 20, "min": 0},
        "max_hp": {"type": "int", "default": 20},
        "attack": 4,
        "armor": 1,
        "speed": 3,
        "mana": {"type": "int", "default": 6, "min": 0}
      }
    }
  },
  "entities": {
    "knight": {"type": "unit", "name": "Sir Bran (knight)", "at": [5, 2], "props": {"role": "fighter", "hp": 26, "max_hp": 26, "attack": 5, "armor": 3, "speed": 2}},
    "rogue": {"type": "unit", "name": "Vess (rogue)", "at": [5, 3], "props": {"role": "skirmisher", "hp": 18, "max_hp": 18, "attack": 5, "armor": 1, "speed": 5}},
    "mage": {"type": "unit", "name": "Ilora (mage)", "at": [5, 1], "props": {"role": "caster", "hp": 15, "max_hp": 15, "attack": 2, "armor": 0, "speed": 3, "mana": 9}},
    "orc": {"type": "unit", "name": "Grasht (orc chief)", "at": [0, 2], "props": {"team": "monsters", "role": "fighter", "hp": 28, "max_hp": 28, "attack": 6, "armor": 2, "speed": 2}},
    "goblin": {"type": "unit", "name": "Nikk (goblin)", "at": [0, 3], "props": {"team": "monsters", "role": "skirmisher", "hp": 14, "max_hp": 14, "attack": 4, "armor": 1, "speed": 6}},
    "shaman": {"type": "unit", "name": "Oma (shaman)", "at": [0, 4], "props": {"team": "monsters", "role": "caster", "hp": 16, "max_hp": 16, "attack": 2, "armor": 0, "speed": 3, "mana": 9}}
  },
  "defs": {
    "enemy": {"args": ["a", "b"], "expr": "$a.team != $b.team", "description": "b fights against a."},
    "damage": {"args": ["by", "to"], "expr": "$max(1, $effective($by, 'attack') - $effective($to, 'armor'))"},
    "nearest_enemy": {"args": ["u"], "expr": "$bottom(unit, $distance($u, $it), 1, $enemy($u, $it))[0]"},
    "steps": {
      "args": ["u"],
      "expr": "$filter([[$u.at[0] - 1, $u.at[1]], [$u.at[0] + 1, $u.at[1]], [$u.at[0], $u.at[1] - 1], [$u.at[0], $u.at[1] + 1]], $it[0] >= 0 and $it[0] < 6 and $it[1] >= 0 and $it[1] < 6 and not $any(unit, $it.at == $outer) and $can_enter($u, $it))",
      "description": "Free squares one step away that the unit may enter."
    },
    "best_step": {"args": ["u"], "expr": "$bottom($steps($u), $distance($it, $nearest_enemy($u)), 1)[0]"}
  },
  "blocks": {
    "fall": {
      "args": ["unit"],
      "do": [{"if": "$unit.alive and $unit.hp <= 0", "then": [{"emit": "fall", "say": "{$unit.name} falls."}, {"remove": "$unit"}]}]
    }
  },
  "actions": {
    "move": {
      "by": "unit",
      "description": "Step one square north, south, east or west into a free square.",
      "params": {"row": {"type": "int", "min": 0, "max": 5}, "col": {"type": "int", "min": 0, "max": 5}},
      "do": [
        {"if": "$distance($actor, [$params.row, $params.col]) != 1", "then": [{"fail": "You can move exactly one square north, south, east or west."}]},
        {"if": "$any(unit, $it.at == [$params.row, $params.col])", "then": [{"fail": "That square is occupied."}]},
        {"conditions": "terrain", "action": "enter", "who": "$actor", "to": "[$params.row, $params.col]"}
      ],
      "outcome": "You move to {$params.row}, {$params.col}.",
      "per_turn": 1
    },
    "strike": {
      "by": "unit",
      "description": "Hit an adjacent enemy for your attack minus its armor.",
      "params": {"target": {"type": "entity", "of": "unit", "where": "$enemy($actor, $it) and $distance($actor, $it) <= 1"}},
      "do": ["$dealt = $damage($actor, $params.target)", "$params.target.hp -= $dealt", {"block": "fall", "with": {"unit": "$params.target"}}],
      "outcome": "You hit {$params.target.name} for {$dealt}.",
      "announce": "{$actor.name} hits {$params.target.name} for {$dealt}.",
      "per_turn": 1,
      "terminal": true
    },
    "poison_blade": {
      "by": "unit",
      "description": "Skirmishers: a light cut that poisons an adjacent enemy (stacks up to 3).",
      "when": [{"expr": "$actor.role == skirmisher", "why": "Only skirmishers carry poisoned blades."}],
      "params": {"target": {"type": "entity", "of": "unit", "where": "$enemy($actor, $it) and $distance($actor, $it) <= 1"}},
      "do": ["$params.target.hp -= 1", {"conditions": "conditions", "action": "apply", "status": "poison", "who": "$params.target"}, {"block": "fall", "with": {"unit": "$params.target"}}],
      "announce": "{$actor.name} poisons {$params.target.name}.",
      "per_turn": 1,
      "terminal": true
    },
    "shield_bash": {
      "by": "unit",
      "description": "Fighters: slam an adjacent enemy for 2 damage and stun it for its next round.",
      "when": [{"expr": "$actor.role == fighter", "why": "Only fighters can shield bash."}],
      "params": {"target": {"type": "entity", "of": "unit", "where": "$enemy($actor, $it) and $distance($actor, $it) <= 1"}},
      "do": ["$params.target.hp -= 2", {"conditions": "conditions", "action": "apply", "status": "stun", "who": "$params.target"}, {"conditions": "spells", "action": "interrupt", "who": "$params.target"}, {"block": "fall", "with": {"unit": "$params.target"}}],
      "announce": "{$actor.name} shield-bashes {$params.target.name}.",
      "per_turn": 1,
      "terminal": true
    },
    "raise_shield": {
      "by": "unit",
      "description": "Fighters: raise a shield over yourself or an adjacent ally (+3 armor for 2 rounds).",
      "when": [{"expr": "$actor.role == fighter", "why": "Only fighters carry shields."}],
      "params": {"ally": {"type": "entity", "of": "unit", "where": "not $enemy($actor, $it) and $distance($actor, $it) <= 1"}},
      "do": [{"conditions": "conditions", "action": "apply", "status": "shield", "who": "$params.ally"}],
      "announce": "{$actor.name} shields {$params.ally.name}.",
      "per_turn": 1,
      "terminal": true
    },
    "fireball": {
      "by": "unit",
      "description": "Casters: spend 3 mana to channel a fireball at an enemy within 4 squares. It explodes at the start of next round (target and adjacent enemies) unless you are stunned first.",
      "when": [{"expr": "$actor.role == caster", "why": "Only casters know the spell."}, {"expr": "$actor.mana >= 3", "why": "You need 3 mana."}],
      "params": {"target": {"type": "entity", "of": "unit", "where": "$enemy($actor, $it) and $distance($actor, $it) <= 4"}},
      "do": ["$actor.mana -= 3"],
      "outcome": "You begin channeling a fireball at {$params.target.name}.",
      "announce": "{$actor.name} begins channeling a fireball at {$params.target.name}!",
      "terminal": true
    },
    "heal": {
      "by": "unit",
      "description": "Casters: restore 5 health to yourself or an ally within 3 squares.",
      "when": [{"expr": "$actor.role == caster", "why": "Only casters can heal."}],
      "params": {"ally": {"type": "entity", "of": "unit", "where": "not $enemy($actor, $it) and $distance($actor, $it) <= 3 and $it.hp < $it.max_hp"}},
      "do": ["$params.ally.hp = $min($params.ally.max_hp, $params.ally.hp + 5)", {"conditions": "conditions", "action": "cleanse", "status": "poison", "who": "$params.ally"}],
      "announce": "{$actor.name} heals {$params.ally.name}.",
      "per_turn": 1,
      "terminal": true
    },
    "hold": {"by": "unit", "description": "Hold your position this round.", "do": [], "private": true, "terminal": true}
  },
  "mechanisms": {
    "conditions": {
      "kind": "conditions",
      "mode": "status",
      "who": "unit",
      "statuses": {
        "poison": {"duration": 3, "stacking": "refresh", "max_stacks": 3, "tick": ["$it.hp -= 2 * $stacks", {"block": "fall", "with": {"unit": "$it"}}], "expire_say": "The poison in {$it.name} wears off."},
        "stun": {"duration": 1, "blocks": ["move", "strike", "poison_blade", "shield_bash", "raise_shield", "fireball", "heal"], "blocked_why": "you are stunned", "say": "{$it.name} is stunned."},
        "shield": {"duration": 2, "modifiers": {"armor": 3}, "immune": ["stun"]}
      }
    },
    "abilities": {
      "kind": "conditions",
      "mode": "cooldowns",
      "actions": {
        "poison_blade": {"cooldown": 1},
        "shield_bash": {"cooldown": 3},
        "raise_shield": {"charges": 2, "recharge": 3},
        "fireball": {"cooldown": 2},
        "heal": {"charges": 2, "recharge": 2}
      }
    },
    "spells": {
      "kind": "conditions",
      "mode": "channeling",
      "actions": {
        "fireball": {
          "rounds": 1,
          "interrupt": "$has_status($actor, 'stun')",
          "interrupt_say": "{$actor.name}'s fireball fizzles out.",
          "resolve": [
            {"if": "not $params.target.alive", "then": [{"fail": "the target is already gone"}]},
            "$params.target.hp -= $inputs.fireball_damage",
            {"each": "unit", "where": "$it.id != $params.target.id and $enemy($actor, $it) and $distance($it, $params.target) <= 1", "do": ["$it.hp -= 2", {"block": "fall", "with": {"unit": "$it"}}]},
            {"block": "fall", "with": {"unit": "$params.target"}}
          ],
          "say": "{$actor.name}'s fireball explodes on {$params.target.name}!"
        }
      }
    },
    "terrain": {
      "kind": "conditions",
      "mode": "terrain",
      "who": "unit",
      "places": {
        "forest": {"description": "cover: +1 armor", "area": [[2, 0], [3, 1]], "modifiers": {"armor": 1}},
        "swamp": {"description": "slow going: -2 speed", "at": [[2, 3], [3, 3]], "modifiers": {"speed": -2}},
        "lava": {"description": "burns 3 health a round", "at": [[2, 5], [3, 5]], "tick": ["$it.hp -= 3", {"block": "fall", "with": {"unit": "$it"}}], "enter": [{"expr": "$it.hp > 8", "why": "The lava would kill you at this health."}]},
        "wall": {"description": "solid rock", "at": [[2, 2], [3, 2]], "enter": [{"expr": "false", "why": "A wall blocks the way."}]}
      }
    },
    "initiative": {
      "kind": "flow",
      "mode": "order",
      "who": "unit",
      "by": "$effective($it, 'speed')",
      "stage": {"actions": "all", "turns": "sequential", "max_actions": 2, "max_calls": 8, "brief": "Your turn: move a square and/or take one combat action."}
    },
    "victory": {
      "kind": "flow",
      "mode": "victory",
      "who": "unit",
      "conditions": [
        {"last_team": "$it.team", "name": "last_team_standing"},
        {"most": "$sum(unit, $it.hp, $it.team == $outer.team)", "name": "time_up", "say": "Time is up: the {$first($map($winner(unit, $sum(unit, $it.hp, $it.team == $outer.team)), $it.team))} have more health left."}
      ]
    }
  },
  "views": {
    "battlefield": {
      "title": "Units (row, col)",
      "of": "unit",
      "sort": "$turn_rank($it, 'initiative')",
      "show": "[{id}] {name} · {team} · hp {hp}/{max_hp} · at {at} · attack {$effective($it, 'attack')}, armor {$effective($it, 'armor')}, speed {$effective($it, 'speed')}{' · mana ' + $text($it.mana) if $it.role == caster else ''}"
    },
    "moves": {
      "for": "unit",
      "title": "Squares you can step to",
      "show": "{$join($map($steps($actor), $text($it[0]) + ',' + $text($it[1])), '; ') or 'none'}"
    }
  },
  "policies": {
    "tactician": {
      "repeat": true,
      "rules": [
        {"when": "$any(unit, $enemy($actor, $it) and $distance($actor, $it) <= 4)", "do": "fireball", "with": {"target": "$bottom(unit, $it.hp, 1, $enemy($actor, $it) and $distance($actor, $it) <= 4)[0]"}},
        {"when": "$any(unit, not $enemy($actor, $it) and $distance($actor, $it) <= 3 and $it.hp <= $it.max_hp - 5)", "do": "heal", "with": {"ally": "$bottom(unit, $it.hp, 1, not $enemy($actor, $it) and $distance($actor, $it) <= 3 and $it.hp < $it.max_hp)[0]"}},
        {"when": "$any(unit, $enemy($actor, $it) and $distance($actor, $it) <= 1)", "do": "shield_bash", "with": {"target": "$bottom(unit, $it.hp, 1, $enemy($actor, $it) and $distance($actor, $it) <= 1)[0]"}},
        {"when": "$any(unit, $enemy($actor, $it) and $distance($actor, $it) <= 1) and not $has_status($bottom(unit, $it.hp, 1, $enemy($actor, $it) and $distance($actor, $it) <= 1)[0], 'poison')", "do": "poison_blade", "with": {"target": "$bottom(unit, $it.hp, 1, $enemy($actor, $it) and $distance($actor, $it) <= 1)[0]"}},
        {"when": "$any(unit, $enemy($actor, $it) and $distance($actor, $it) <= 1)", "do": "strike", "with": {"target": "$bottom(unit, $it.hp, 1, $enemy($actor, $it) and $distance($actor, $it) <= 1)[0]"}},
        {"when": "$actor.hp < $actor.max_hp and $any(unit, $enemy($actor, $it) and $distance($actor, $it) <= 2)", "do": "raise_shield", "with": {"ally": "$actor"}},
        {"when": "$any(unit, $enemy($actor, $it)) and $len($steps($actor)) > 0 and $distance($best_step($actor), $nearest_enemy($actor)) < $distance($actor, $nearest_enemy($actor))", "do": "move", "with": {"row": "$best_step($actor)[0]", "col": "$best_step($actor)[1]"}},
        {"do": "hold"}
      ]
    }
  },
  "metrics": {
    "heroes_hp": "$sum(unit, $it.hp, $it.team == heroes)",
    "monsters_hp": "$sum(unit, $it.hp, $it.team == monsters)",
    "poisoned": "$count(unit, $has_status($it, 'poison'))"
  },
  "outputs": {
    "winning_team": {"expr": "$first($unique($map(unit, $it.team))) if $len($unique($map(unit, $it.team))) == 1 else 'undecided'", "type": "text", "description": "heroes, monsters, or undecided while both still fight."},
    "heroes_left": {"expr": "$count(unit, $it.team == heroes)", "type": "int"},
    "monsters_left": {"expr": "$count(unit, $it.team == monsters)", "type": "int"},
    "heroes_hp": {"expr": "$metrics.heroes_hp", "type": "int"},
    "monsters_hp": {"expr": "$metrics.monsters_hp", "type": "int"},
    "peak_poisoned": {"expr": "$max($series.poisoned, $it) or 0", "type": "int"}
  },
  "invariants": [
    {"expr": "$all(unit, $it.hp <= $it.max_hp)", "why": "Healing never raises health above the maximum."}
  ]
}
